void pageNotifications() {
  String s = htmlHead("Meldungen");
  s += "<div class='card'><h2>Meldungen fuer LCD und Web einstellen</h2>";
  s += "<p class='small muted'>Aenderungen sind nach Speichern sofort auch auf dem Touchdisplay aktiv.";
  s += " Messungen und Ereignisprotokoll bleiben unabhaengig von der Anzeige aktiv.</p>";
  s += "<form method='post' action='/notifications/save'><div class='scroll'><table>";
  s += "<tr><th>Ereignis</th><th>LCD</th><th>Browser</th></tr>";
  for (uint8_t i = 0; i < N_COUNT; ++i) {
    String key = String(i);
    s += "<tr><td>" + escapeHTML(String(noticeName((NoticeType)i))) + "</td><td>";
    s += "<input type='checkbox' name='d" + key + "' style='width:auto'";
    if (noticeDisplayMask & (1U << i)) s += " checked";
    s += "></td><td><input type='checkbox' name='w" + key + "' style='width:auto'";
    if (noticeWebMask & (1U << i)) s += " checked";
    s += "></td></tr>";
  }
  s += "</table></div><button class='ok'>Meldungseinstellungen speichern</button></form></div>";
  s += "<div class='card'><h2>Letzte Browsermeldungen</h2>";
  if (!noticeCount) s += "<p>Noch keine Meldungen aufgetreten.</p>";
  for (uint8_t i = 0; i < noticeCount; ++i) {
    s += "<p><b>" + escapeHTML(noticeRecords[i].date) + "</b> - " +
         escapeHTML(noticeRecords[i].message) + "</p>";
  }
  s += "<p class='small muted'>Nur Meldungen seit dem Einschalten; ein ausgeschalteter Browserkanal erzeugt keine Browsermeldung.</p></div>";
  s += htmlFoot();
  server.send(200, "text/html", s);
}

void pageNoticeAPI() {
  JsonDocument d;
  d["sequence"] = noticeSequence;
  JsonArray a = d["events"].to<JsonArray>();
  for (uint8_t i = 0; i < noticeCount && i < 8; ++i) {
    JsonObject o = a.add<JsonObject>();
    o["id"] = noticeRecords[i].id;
    o["type"] = noticeName(noticeRecords[i].type);
    o["message"] = noticeRecords[i].message;
    o["date"] = noticeRecords[i].date;
  }
  String out;
  serializeJson(d, out);
  server.send(200, "application/json", out);
}

// =====================================================
// V1.8: BACKUP, VERSIONIERT, OHNE PASSWOERTER/TOKENS
// =====================================================

void downloadBackup() {
  JsonDocument doc;
  doc["format"] = "filamentwaage-backup";
  doc["version"] = "1.0.0";
  doc["created"] = timestamp();
  JsonObject st = doc["settings"].to<JsonObject>();
  st["expected"] = expectedGrams;
  st["deduct"] = manualDeductionGrams;
  st["low"] = lowFilamentThreshold;
  st["bview"] = bambuViewMode;
  st["bright"] = displayBrightness;
  st["timeout"] = displayTimeoutChoice;
  st["dark"] = displayDarkMode;
  st["notice"] = displayNotifications;
  st["dmask"] = noticeDisplayMask;
  st["wmask"] = noticeWebMask;
  st["custom"] = customColorsEnabled;
  st["bg"] = customBgRgb;
  st["fg"] = customTextRgb;
  st["zero"] = zeroOffset;
  st["zeroOK"] = zeroValid;
  st["hardware"] = "Hosyond ESP32-32E + HX711 GPIO32/25";
  doc["activeProfile"] = activeProfile;
  JsonArray p = doc["profiles"].to<JsonArray>();
  for (int i = 0; i < profileCount; ++i) {
    JsonObject v = p.add<JsonObject>();
    v["n"] = profiles[i].name;
    v["m"] = profiles[i].material;
    v["e"] = profiles[i].emptyWeight;
    v["f"] = profiles[i].fullWeight;
    v["rgb"] = profiles[i].rgb;
    v["price"] = profiles[i].priceKg;
  }
  JsonArray h = doc["history"].to<JsonArray>();
  for (int i = 0; i < historyCount; ++i) {
    JsonObject v = h.add<JsonObject>();
    v["d"] = historyItems[i].date;
    v["n"] = historyItems[i].name;
    v["f"] = historyItems[i].filament;
    v["u"] = historyItems[i].used;
    v["sw"] = historyItems[i].startWeight;
    v["ew"] = historyItems[i].endWeight;
    v["t"] = historyItems[i].seconds;
    v["cost"] = historyItems[i].cost;
    v["ok"] = historyItems[i].confirmed;
  }
  String out;
  serializeJsonPretty(doc, out);
  server.sendHeader("Content-Disposition", "attachment; filename=filamentwaage-v1.0.0-backup.json");
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json; charset=utf-8", out);
}

void restoreBackup() {
  if (printActive || printEndPending) {
    server.send(409, "text/plain", "Wiederherstellung waehrend eines Drucks nicht erlaubt");
    return;
  }
  String body = server.arg("plain");
  if (body.length() < 50 || body.length() > 28000) {
    server.send(413, "text/plain", "Ungueltige oder zu grosse Backup-Datei");
    return;
  }
  JsonDocument doc;
  if (deserializeJson(doc, body) ||
      doc["format"].as<String>() != "filamentwaage-backup" ||
      !doc["settings"].is<JsonObject>() || !doc["profiles"].is<JsonArray>() ||
      !doc["history"].is<JsonArray>()) {
    server.send(400, "text/plain", "Dateiformat / JSON ungueltig");
    return;
  }
  JsonArrayConst p = doc["profiles"].as<JsonArrayConst>();
  JsonArrayConst h = doc["history"].as<JsonArrayConst>();
  if (p.size() < 1 || p.size() > MAX_PROFILES || h.size() > MAX_HISTORY) {
    server.send(400, "text/plain", "Unzulaessige Profil- oder Archivanzahl");
    return;
  }
  // Erst vollstaendig in Zwischenpuffer pruefen: niemals halbimportiertes JSON uebernehmen.
  FilamentProfile newProfiles[MAX_PROFILES];
  PrintRecord newHistory[MAX_HISTORY];
  for (size_t i = 0; i < p.size(); ++i) {
    JsonObjectConst v = p[i].as<JsonObjectConst>();
    newProfiles[i].name = v["n"].as<String>();
    newProfiles[i].material = v["m"].as<String>();
    newProfiles[i].emptyWeight = v["e"] | -1.0f;
    newProfiles[i].fullWeight = v["f"] | -1.0f;
    newProfiles[i].rgb = v["rgb"] | 0x21C5FFUL;
    newProfiles[i].priceKg = v["price"] | -1.0f;
    if (newProfiles[i].name.isEmpty() || newProfiles[i].name.length() > 32 ||
        newProfiles[i].material.isEmpty() || newProfiles[i].material.length() > 12 ||
        !isfinite(newProfiles[i].emptyWeight) || newProfiles[i].emptyWeight < 0 ||
        newProfiles[i].emptyWeight > 5000 || !isfinite(newProfiles[i].fullWeight) ||
        newProfiles[i].fullWeight <= 0 || newProfiles[i].fullWeight > 5000 ||
        !isfinite(newProfiles[i].priceKg) || newProfiles[i].priceKg < 0 ||
        newProfiles[i].priceKg > 1000) {
      server.send(400, "text/plain", "Profil im Backup ungueltig");
      return;
    }
  }
  for (size_t i = 0; i < h.size(); ++i) {
    JsonObjectConst v = h[i].as<JsonObjectConst>();
    newHistory[i].date = v["d"].as<String>();
    newHistory[i].name = v["n"].as<String>();
    newHistory[i].filament = v["f"].as<String>();
    newHistory[i].used = v["u"] | -1.0f;
    newHistory[i].startWeight = v["sw"] | 0.0f;
    newHistory[i].endWeight = v["ew"] | 0.0f;
    newHistory[i].seconds = v["t"] | 0UL;
    newHistory[i].cost = v["cost"] | -1.0f;
    newHistory[i].confirmed = v["ok"] | false;
    if (newHistory[i].date.length() > 32 || newHistory[i].name.length() > 100 ||
        newHistory[i].filament.length() > 80 || !isfinite(newHistory[i].used) ||
        newHistory[i].used < 0 || newHistory[i].used > 5000 ||
        !isfinite(newHistory[i].cost) || newHistory[i].cost < 0 || newHistory[i].cost > 5000 ||
        !isfinite(newHistory[i].startWeight) || !isfinite(newHistory[i].endWeight)) {
      server.send(400, "text/plain", "Archiveintrag ungueltig");
      return;
    }
  }
  JsonObjectConst st = doc["settings"].as<JsonObjectConst>();
  float newExpected = st["expected"] | -1.0f;
  // Alte V1.8-Backups ohne Abzug behalten den aktuellen Wert bei.
  float newDeduct = st["deduct"] | manualDeductionGrams;
  float newLow = st["low"] | -1.0f;
  uint8_t newBView = st["bview"] | 255;
  uint8_t newBright = st["bright"] | 0;
  uint8_t newTimeout = st["timeout"] | 255;
  bool newDark = st["dark"] | true;
  bool newNotice = st["notice"] | true;
  uint16_t newDMask = (uint16_t)(st["dmask"] | 0xFFFF);
  uint16_t newWMask = (uint16_t)(st["wmask"] | 0xFFFF);
  bool newCustom = st["custom"] | false;
  uint32_t newBg = st["bg"] | 0x080C10UL;
  uint32_t newFg = st["fg"] | 0xFFFFFFUL;
  int newActive = doc["activeProfile"] | -1;
  if (!isfinite(newExpected) || newExpected < 0 || newExpected > 5000 ||
      !isfinite(newDeduct) || newDeduct < 0 || newDeduct > 5000 ||
      !isfinite(newLow) || newLow < 0 || newLow > 5000 ||
      newBView > 2 || newBright < 10 || newBright > 100 || newTimeout > 4 ||
      newDMask > 255 || newWMask > 255 ||
      newActive < 0 || newActive >= (int)p.size() ||
      (newCustom && !readableColors(newBg, newFg))) {
    server.send(400, "text/plain", "Einstellungen im Backup ungueltig");
    return;
  }
  bool restoreZero = server.arg("zero") == "1";
  long newZero = st["zero"] | 0L;
  bool newZeroValid = st["zeroOK"] | false;
  if (restoreZero && (newZero > 8388607L || newZero < -8388608L)) {
    server.send(400, "text/plain", "Nullpunkt ausserhalb HX711-Bereich");
    return;
  }

  // Ab hier ist die komplette Datei plausibilisiert.
  profileCount = (int)p.size();
  activeProfile = newActive;
  for (int i = 0; i < profileCount; ++i) profiles[i] = newProfiles[i];
  historyCount = (int)h.size();
  for (int i = 0; i < historyCount; ++i) historyItems[i] = newHistory[i];
  saveProfiles();
  saveHistory();
  expectedGrams = newExpected;
  manualDeductionGrams = newDeduct;
  lowFilamentThreshold = newLow;
  bambuViewMode = newBView;
  displayBrightness = newBright;
  displayTimeoutChoice = newTimeout;
  displayDarkMode = newDark;
  displayNotifications = newNotice;
  noticeDisplayMask = newDMask;
  noticeWebMask = newWMask;
  customColorsEnabled = newCustom;
  customBgRgb = newBg & 0xFFFFFFUL;
  customTextRgb = newFg & 0xFFFFFFUL;
  prefs.putFloat("expected", expectedGrams);
  prefs.putFloat("wDeduct", manualDeductionGrams);
  prefs.putUChar("bview", bambuViewMode);
  prefs.putUChar("dBright", displayBrightness);
  prefs.putUChar("dTime", displayTimeoutChoice);
  prefs.putBool("dDark", displayDarkMode);
  prefs.putBool("dNotice", displayNotifications);
  prefs.putBool("custClr", customColorsEnabled);
  prefs.putUInt("bgRGB", customBgRgb);
  prefs.putUInt("txRGB", customTextRgb);
  saveV18Settings();
  if (restoreZero) {
    zeroOffset = newZero;
    zeroValid = newZeroValid;
    prefs.putLong("zero", zeroOffset);
    prefs.putBool("zeroOK", zeroValid);
    filterReady = false;
    recentCount = 0;
    recentIndex = 0;
    stable = false;
    lastStableAt = 0;
  }
  pendingNoticeDisplayMask = noticeDisplayMask;
  pendingNoticeWebMask = noticeWebMask;
  pendingBrightness = displayBrightness;
  pendingTimeoutChoice = displayTimeoutChoice;
  pendingDarkMode = displayDarkMode;
  pendingNotifications = displayNotifications;
  pendingCustomColors = customColorsEnabled;
  pendingBgRgb = customBgRgb;
  pendingTextRgb = customTextRgb;
  pendingBambuViewMode = bambuViewMode;
  applyDisplayTheme();
  setDisplayBacklight();
  recalculateFilamentRemaining();
  pageDirty = true;
  logEvent("V1.0.0 Backup wiederhergestellt (Zugangsdaten unveraendert)");
  server.send(200, "text/plain", "Wiederherstellung erfolgreich. Seite neu laden.");
}

// =====================================================
// 39. WEBROUTEN
// =====================================================

void startWebServer() {
  server.on("/notifications", HTTP_GET, []() {
    if (!checkLogin()) return;
    pageNotifications();
  });
  server.on("/api/notices", HTTP_GET, []() {
    if (!checkLogin()) return;
    pageNoticeAPI();
  });
  server.on("/notifications/save", HTTP_POST, []() {
    if (!checkLogin()) return;
    uint16_t dm = 0, wm = 0;
    for (uint8_t i = 0; i < N_COUNT; ++i) {
      if (server.hasArg("d" + String(i))) dm |= (1U << i);
      if (server.hasArg("w" + String(i))) wm |= (1U << i);
    }
    noticeDisplayMask = dm;
    noticeWebMask = wm;
    pendingNoticeDisplayMask = dm;
    pendingNoticeWebMask = wm;
    saveV18Settings();
    pageDirty = true;
    logEvent("Meldungstypen fuer LCD und Browser gespeichert");
    redirect("/notifications");
  });
  server.on("/warning/save", HTTP_POST, []() {
    if (!checkLogin()) return;
    float low = server.arg("low").toFloat();
    if (!isfinite(low) || low < 0 || low > 5000) {
      server.send(400, "text/plain", "Ungueltige Warnschwelle");
      return;
    }
    lowFilamentThreshold = low;
    warnedLow = false;
    saveV18Settings();
    redirect("/settings");
  });
  server.on("/backup", HTTP_GET, []() {
    if (!checkLogin()) return;
    downloadBackup();
  });
  server.on("/restore", HTTP_POST, []() {
    if (!checkLogin()) return;
    restoreBackup();
  });
  server.on("/", HTTP_GET, []() {
    if (!checkLogin()) return;
    pageHome();
  });

  server.on("/api", HTTP_GET, []() {
    if (!checkLogin()) return;
    pageAPI();
  });

  server.on("/profiles", HTTP_GET, []() {
    if (!checkLogin()) return;
    pageProfiles();
  });

  server.on("/profile/save", HTTP_POST, []() {
    if (!checkLogin()) return;
    saveProfileWeb();
  });

  server.on("/profile/select", HTTP_POST, []() {
    if (!checkLogin()) return;
    selectProfileWeb();
  });

  server.on("/profile/delete", HTTP_POST, []() {
    if (!checkLogin()) return;
    deleteProfileWeb();
  });

  server.on("/printer", HTTP_GET, []() {
    if (!checkLogin()) return;
    pageBambu();
  });

  server.on("/settings", HTTP_GET, []() {
    if (!checkLogin()) return;
    pageSettings();
  });

  server.on("/display/save", HTTP_POST, []() {
    if (!checkLogin()) return;
    int bright = server.arg("brightness").toInt();
    int tm = server.arg("timeout").toInt();
    if (bright < 10 || bright > 100 || tm < 0 || tm > 4) {
      server.send(400, "text/plain", "Ungueltige Display-Werte");
      return;
    }
    pendingBrightness = (uint8_t)bright;
    pendingTimeoutChoice = (uint8_t)tm;
    pendingDarkMode = server.hasArg("dark");
    pendingNotifications = server.hasArg("notice");
    pendingCustomColors = server.hasArg("custom");
    if (pendingCustomColors) {
      String bg = server.arg("bgcolor");
      String fg = server.arg("textcolor");
      bool validHex = bg.length() == 7 && fg.length() == 7 &&
        bg.startsWith("#") && fg.startsWith("#");
      if (validHex) {
        for (uint8_t i = 1; i <= 6; ++i) {
          if (!isxdigit((unsigned char)bg[i]) ||
              !isxdigit((unsigned char)fg[i])) validHex = false;
        }
      }
      if (!validHex) {
        server.send(400, "text/plain", "Ungueltiger RGB-Hexwert");
        return;
      }
      // Keine stillschweigende Farbersetzung bei ungueltigen Werten.
      uint32_t bgRgb = readHexColor(bg);
      uint32_t textRgb = readHexColor(fg);
      if (!readableColors(bgRgb, textRgb)) {
        server.send(400, "text/plain",
          "Schrift und Hintergrund haben zu wenig Kontrast. Bitte hellere/dunklere Farbe waehlen.");
        return;
      }
      pendingBgRgb = bgRgb;
      pendingTextRgb = textRgb;
    } else {
      updatePendingColorDefaults();
    }
    saveDisplayPrefs();
    redirect("/settings");
  });

  server.on("/bambu/view", HTTP_POST, []() {
    if (!checkLogin()) return;
    int selected = server.arg("mode").toInt();
    if (selected < 0 || selected > 2 ||
        (server.arg("mode") != "0" &&
         server.arg("mode") != "1" &&
         server.arg("mode") != "2")) {
      server.send(400, "text/plain", "Ungueltiger Modus");
      return;
    }
    bambuViewMode = (uint8_t)selected;
    prefs.putUChar("bview", bambuViewMode);
    logEvent("Bambu-Ansicht: " + bambuViewName(bambuViewMode));
    pageDirty = true;
    redirect("/settings");
  });

  server.on("/history", HTTP_GET, []() {
    if (!checkLogin()) return;
    pageHistory();
  });

  server.on("/history.csv", HTTP_GET, []() {
    if (!checkLogin()) return;
    downloadCSV();
  });

  server.on("/console", HTTP_GET, []() {
    if (!checkLogin()) return;
    pageConsole();
  });

  // Gewichtsabzug nur ueber die Weboberflaeche. Gespeichert im vorhandenen
  // NVS-Namespace "fw-v13", unabhaengig vom aktiven Filamentprofil.
  server.on("/weight/deduction", HTTP_POST, []() {
    if (!checkLogin()) return;
    if (!server.hasArg("deduct")) {
      server.send(400, "text/plain", "Gramm-Abzug fehlt");
      return;
    }
    String entered = server.arg("deduct");
    entered.trim();
    entered.replace(',', '.');
    if (entered.isEmpty() || entered.length() > 16) {
      server.send(400, "text/plain", "Ungueltiger Gewichtsabzug");
      return;
    }
    char* end = nullptr;
    const float value = strtof(entered.c_str(), &end);
    if (!end || *end != '\0' || !isfinite(value) || value < 0.0f || value > 5000.0f) {
      server.send(400, "text/plain", "Bitte 0 bis 5000 Gramm eingeben");
      return;
    }
    manualDeductionGrams = value;
    prefs.putFloat("wDeduct", manualDeductionGrams);
    recalculateFilamentRemaining();
    pageDirty = true;
    logEvent("Gewichtsabzug gespeichert: " + String(manualDeductionGrams, 1) + " g");
    redirect("/");
  });

  server.on("/estimate", HTTP_POST, []() {
    if (!checkLogin()) return;

    expectedGrams = clampFloat(
      server.arg("grams").toFloat(),
      0,
      5000
    );

    prefs.putFloat(
      "expected",
      expectedGrams
    );

    redirect("/");
  });

  server.on("/tare", HTTP_POST, []() {
    if (!checkLogin()) return;

    if (!tareScale()) {
      server.send(
        503,
        "text/plain",
        "Tara fehlgeschlagen"
      );
      return;
    }

    redirect("/settings");
  });

  server.on("/print/start", HTTP_POST, []() {
    if (!checkLogin()) return;
    startPrint(false);
    redirect("/");
  });

  server.on("/print/stop", HTTP_POST, []() {
    if (!checkLogin()) return;
    stopPrint();
    redirect("/");
  });

  server.onNotFound([]() {
    if (!checkLogin()) return;

    server.send(
      404,
      "text/plain",
      "Seite nicht gefunden"
    );
  });

  server.begin();

  logEvent(
    "Webserver mit Login gestartet"
  );
}

// =====================================================
// 39A. TESTBEFEHLE (NUR BENACHRICHTIGUNGEN)
// =====================================================
// Diese Schnittstelle simuliert nur eine Meldung. Sie startet/stoppt
// KEINEN echten Druck, veraendert KEINE Messwerte, Profile oder
// Statistiken und schreibt keine neuen NVS-Einstellungen.
// Arduino IDE -> Serieller Monitor, 115200 Baud, Zeilenende: Neue Zeile.
// TEST ALL sendet mit Abstand: am LCD bleibt jede Meldung ca. 5 s.

const char* const noticeTestWords[N_COUNT] = {
  "LOW", "START", "END", "ERROR", "MOTION", "LOST", "RESTORED", "PAUSE"
};

bool noticeTestAllRunning = false;
uint8_t noticeTestNext = 0;
uint32_t noticeTestDue = 0;

void showNoticeTestHelp() {
  Serial.println(F("[TEST] Befehle (115200 Baud, Zeilenende: Neue Zeile):"));
  Serial.println(F("  HELP"));
  Serial.println(F("  TEST LOW / START / END / ERROR / MOTION"));
  Serial.println(F("  TEST LOST / RESTORED / PAUSE"));
  Serial.println(F("  TEST ALL  (alle 8 Typen nacheinander, je 5.8 s)"));
  Serial.println(F("  TEST STOP (laufende Testreihe abbrechen)"));
  Serial.println(F("[TEST] Kein Einfluss auf Druck, Waage oder Archiv."));
}

void sendTestNotice(NoticeType type) {
  // Die reale Meldungsfunktion wird mit den eingestellten LCD-/Web-
  // Masken genutzt. So laesst sich auch das Abschalten direkt testen.
  emitNotice(type, String("TEST: ") + noticeName(type));
  const uint16_t mask = (uint16_t)1U << (uint8_t)type;
  Serial.print(F("[TEST] "));
  Serial.print(noticeTestWords[(uint8_t)type]);
  Serial.print(F(" | LCD="));
  Serial.print(displayNotifications && (noticeDisplayMask & mask) ? F("EIN") : F("AUS"));
  Serial.print(F(" | WEB="));
  Serial.println((noticeWebMask & mask) ? F("EIN") : F("AUS"));
}

void processNoticeTestCommand(String command) {
  command.trim();
  command.toUpperCase();
  if (!command.length()) return;
  if (command == "HELP" || command == "?") {
    showNoticeTestHelp();
    return;
  }
  if (command == "TEST STOP") {
    noticeTestAllRunning = false;
    Serial.println(F("[TEST] Testreihe abgebrochen."));
    return;
  }
  if (command == "TEST ALL") {
    noticeTestAllRunning = true;
    noticeTestNext = 1;
    noticeTestDue = millis() + 5800UL;
    Serial.println(F("[TEST] Testreihe gestartet; TEST STOP zum Abbrechen."));
    sendTestNotice(N_LOW);
    return;
  }
  for (uint8_t i = 0; i < N_COUNT; ++i) {
    if (command == (String("TEST ") + noticeTestWords[i])) {
      noticeTestAllRunning = false;
      sendTestNotice((NoticeType)i);
      return;
    }
  }
  Serial.println(F("[TEST] Unbekannter Befehl. HELP eingeben."));
}

void serviceNoticeTestCommands() {
  // Keine blockierenden String-Leseoperationen: MQTT, HX711 und
  // Touch koennen parallel ohne zusaetzliche Wartezeit weiterlaufen.
  static char input[48] = {0};
  static uint8_t used = 0;
  uint8_t budget = 0;
  while (Serial.available() > 0 && budget++ < 64) {
    char c = (char)Serial.read();
    if (c == '\r' || c == '\n') {
      if (used) {
        input[used] = '\0';
        processNoticeTestCommand(String(input));
        used = 0;
      }
    } else if (c >= 32 && c <= 126) {
      if (used < sizeof(input) - 1) {
        input[used++] = c;
      } else {
        used = 0;
        Serial.println(F("[TEST] Befehl zu lang. HELP eingeben."));
      }
    }
  }
  if (noticeTestAllRunning && (int32_t)(millis() - noticeTestDue) >= 0) {
    if (noticeTestNext < N_COUNT) {
      sendTestNotice((NoticeType)noticeTestNext++);
      noticeTestDue = millis() + 5800UL;
    }
    if (noticeTestNext >= N_COUNT) {
      noticeTestAllRunning = false;
      Serial.println(F("[TEST] Testreihe abgeschlossen."));
    }
  }
}

// =====================================================
// 40. SERIELLE DIAGNOSE
// =====================================================

void serialStatus() {
  if (millis() - lastSerialStatus < 2000) {
    return;
  }

  lastSerialStatus = millis();

  Serial.print("Rohwert: ");
  Serial.print(rawValue);

  Serial.print(" | Gewicht: ");
  Serial.print(displayedWeightGrams(), 2);

  Serial.print(" g | Rest: ");
  Serial.print(restGrams, 2);

  Serial.print(" g | Prozent: ");
  Serial.print(fillPercent, 1);

  Serial.print(" | Faktor: ");
  Serial.print(SCALE_FACTOR, 1);

  Serial.print(" | Nullpunkt: ");
  Serial.print(zeroOffset);

  Serial.print(" | Stabil: ");
  Serial.print(stable ? "JA" : "NEIN");

  Serial.print(" | WLAN: ");
  Serial.print(
    WiFi.status() == WL_CONNECTED
      ? "OK"
      : "OFFLINE"
  );

  Serial.print(" | Bambu: ");
  Serial.println(bambuState);
}

// =====================================================
// 41. SETUP
// =====================================================

void setup() {
  Serial.begin(115200);
  delay(400);

  Serial.println();
  Serial.println("===============================");
  Serial.println("FILAMENTWAAGE V1.0.0 STARTET");
  Serial.println("===============================");

  // Gleicher Speicherbereich wie V1.4:
  // Vorhandene Profile und Archivdaten bleiben.

  prefs.begin("fw-v13", false);

  expectedGrams =
    prefs.getFloat("expected", 0);
  // Eigener NVS-Schluessel, bestehende V1.7/V1.8-Daten unveraendert.
  manualDeductionGrams = prefs.getFloat("wDeduct", 0.0f);
  if (!isfinite(manualDeductionGrams) || manualDeductionGrams < 0.0f ||
      manualDeductionGrams > 5000.0f) manualDeductionGrams = 0.0f;
  lowFilamentThreshold = clampFloat(prefs.getFloat("lowGram", 100), 0, 5000);
  noticeDisplayMask = (uint16_t)(prefs.getUInt("ntDMask", 0xFF) & 0xFF);
  noticeWebMask = (uint16_t)(prefs.getUInt("ntWMask", 0xFF) & 0xFF);
  pendingNoticeDisplayMask = noticeDisplayMask;
  pendingNoticeWebMask = noticeWebMask;

  // Standard ist BEIDES. Dieselbe Auswahl kann
  // unter SYSTEM oder in der Weboberflaeche geaendert werden.
  bambuViewMode = prefs.getUChar("bview", 2);
  if (bambuViewMode > 2) bambuViewMode = 2;
  pendingBambuViewMode = bambuViewMode;

  displayBrightness = constrain((int)prefs.getUChar("dBright", 88), 10, 100);
  displayTimeoutChoice = prefs.getUChar("dTime", 2);
  if (displayTimeoutChoice > 4) displayTimeoutChoice = 2;
  displayDarkMode = prefs.getBool("dDark", true);
  displayNotifications = prefs.getBool("dNotice", true);
  pendingBrightness = displayBrightness;
  pendingTimeoutChoice = displayTimeoutChoice;
  pendingDarkMode = displayDarkMode;
  pendingNotifications = displayNotifications;
  customColorsEnabled = prefs.getBool("custClr", false);
  customBgRgb = prefs.getUInt("bgRGB", defaultBackgroundRgb(displayDarkMode)) & 0xFFFFFFUL;
  customTextRgb = prefs.getUInt("txRGB", defaultTextRgb(displayDarkMode)) & 0xFFFFFFUL;
  // Rueckfall auf Standard, falls alte/kaputte Einstellungen nicht lesbar sind.
  if (customColorsEnabled && !readableColors(customBgRgb, customTextRgb))
    customColorsEnabled = false;
  pendingCustomColors = customColorsEnabled;
  pendingBgRgb = customBgRgb;
  pendingTextRgb = customTextRgb;
  updatePendingColorDefaults();

  loadProfiles();
  loadHistory();

  // Displaybeleuchtung
  pinMode(TFT_LED, OUTPUT);
  digitalWrite(TFT_LED, HIGH);

  lcd.init();
  lcd.setRotation(1);
  lcd.setBrightness(255);
  applyDisplayTheme();
  lastDisplayInteraction = millis();
  setDisplayBacklight();
  lcd.fillScreen(BG);

  txt(
    "FILAMENTWAAGE",
    240, 125, 3,
    WHITE, middle_center
  );

  txt(
    "VERSION 1.0.0",
    240, 178, 2,
    GREEN, middle_center
  );

  Serial.print("Display: ");
  Serial.print(lcd.width());
  Serial.print(" x ");
  Serial.println(lcd.height());

  // NEU V1.5:
  // 16 Bit statt 8 Bit.
  // RGB565-Puffer: ca. 46,8 KB.

  sprite.setColorDepth(16);

  spriteReady =
    sprite.createSprite(450, 52) != nullptr;

  if (spriteReady) {
    logEvent("Display-Sprite bereit");
  } else {
    logEvent(
      "WARNUNG: Sprite konnte nicht angelegt werden"
    );
  }

  initScale();
  connectWiFi();

  // Bambu MQTT ueber TLS.
  // WICHTIG:
  // Zertifikat wird in dieser Testversion
  // nicht geprueft.

  tls.setInsecure();
  tls.setTimeout(3);

  mqtt.setServer(
    "us.mqtt.bambulab.com",
    8883
  );

  mqtt.setCallback(onBambuMessage);

  mqtt.setBufferSize(8192);
  mqtt.setKeepAlive(45);
  mqtt.setSocketTimeout(3);

  startWebServer();

  pageDirty = true;

  logEvent("Filamentwaage V1.0.0 bereit");
  Serial.println(F("Serielle Meldungstests: HELP eingeben (115200 Baud)."));

  logEvent(
    "Webseite: http://" + currentIP()
  );
}

// =====================================================
// 42. HAUPTSCHLEIFE
// =====================================================

void loop() {
  server.handleClient();

  maintainWiFi();
  updateScale();
  serviceHybridFinal();
  updateTouch();
  maintainBambu();
  maintainDisplayTimeout();
  updateDisplay();
  serialStatus();
  serviceNoticeTestCommands();

  delay(5);
}

// ================= ENDE V1.0.0 =================
