  lcd.fillScreen(BG);
  txt("BAMBU - ANZEIGE WAEHLEN", 240, 15, 2, WHITE, TC_DATUM);
  txt("Welche Filamentquellen anzeigen?", 240, 48, 1, GRAY, TC_DATUM);

  button(18, 76, 444, 42,
    pendingBambuViewMode == 0 ? "[X] AMS LITE (4 PLAETZE)" : "[ ] AMS LITE (4 PLAETZE)",
    pendingBambuViewMode == 0 ? BLUE : CARD2);
  button(18, 128, 444, 42,
    pendingBambuViewMode == 1 ? "[X] EXTERNE SPULE" : "[ ] EXTERNE SPULE",
    pendingBambuViewMode == 1 ? BLUE : CARD2);
  button(18, 180, 444, 42,
    pendingBambuViewMode == 2 ? "[X] BEIDES ANZEIGEN" : "[ ] BEIDES ANZEIGEN",
    pendingBambuViewMode == 2 ? BLUE : CARD2);

  button(18, 251, 211, 52, "ABBRECHEN", CARD2);
  button(251, 251, 211, 52, "SPEICHERN", GREEN);
}

void openBambuOptions() {
  pendingBambuViewMode = bambuViewMode;
  currentPage = PAGE_BAMBU_OPTIONS;
  pageDirty = true;
}

void saveBambuOptions() {
  bambuViewMode = pendingBambuViewMode;
  prefs.putUChar("bview", bambuViewMode);
  logEvent("Bambu-Ansicht: " + bambuViewName(bambuViewMode));
  currentPage = PAGE_SYSTEM;
  pageDirty = true;
}

// -----------------------------------------------------
// V1.7: freier RGB-Farbeditor per Touch, auch ohne Browser.
// Die Aenderungen werden erst unter ANZEIGE > SPEICHERN persistent.
// -----------------------------------------------------
void openThemeColors() {
  updatePendingColorDefaults();
  editBgRgb = pendingBgRgb;
  editTextRgb = pendingTextRgb;
  themeEditTarget = 0;
  themeColorInputMode = 0;
  themeHexDigits = "";
  colorContrastWarning = false;
  currentPage = PAGE_THEME_COLORS;
  pageDirty = true;
}

void drawThemeColors() {
  lcd.fillScreen(BG);
  txt("DISPLAY-FARBEN", 240, 12, 2, WHITE, TC_DATUM);

  button(12, 38, 220, 37, "HINTERGRUND", themeEditTarget == 0 ? BLUE : CARD2);
  button(248, 38, 220, 37, "SCHRIFTFARBE", themeEditTarget == 1 ? BLUE : CARD2);

  // Vorschau und aktueller HEX-Wert des gewaelten Bereichs.
  uint32_t selected = themeEditTarget == 0 ? editBgRgb : editTextRgb;
  lcd.fillRoundRect(12, 81, 456, 42, 6, rgb565(editBgRgb));
  lcd.drawRoundRect(12, 81, 456, 42, 6, GRAY);
  txt("Aa 123", 23, 93, 2, rgb565(editTextRgb));
  txt(colorHex(selected), 450, 96, 2, rgb565(editTextRgb), MR_DATUM);

  button(12, 130, 220, 29, "12 FARBEN", themeColorInputMode == 0 ? BLUE : CARD2);
  button(248, 130, 220, 29, "HEX #RRGGBB", themeColorInputMode == 1 ? BLUE : CARD2);

  if (themeColorInputMode == 0) {
    // Die gleichen 12 Grundfarben wie bei den Filamentprofilen.
    for (int i = 0; i < PALETTE_COUNT; i++) {
      int col = i % 6;
      int row = i / 6;
      int px = 17 + col * 77;
      int py = 165 + row * 40;
      lcd.fillRoundRect(px, py, 61, 33, 5, rgb565(PALETTE[i]));
      if (selected == PALETTE[i]) {
        lcd.drawRoundRect(px - 2, py - 2, 65, 37, 6, WHITE);
      }
    }
    txt("Farbe antippen oder HEX-Code eingeben", 240, 251, 1, GRAY, TC_DATUM);
  } else {
    // HEX-Eingabe direkt am Touchdisplay, kein Browser noetig.
    const char* hexKeys = "0123456789ABCDEF";
    for (int i = 0; i < 16; i++) {
      int col = i % 8;
      int row = i / 8;
      int kx = 17 + col * 57;
      int ky = 165 + row * 40;
      button(kx, ky, 51, 34, String(hexKeys[i]), CARD2);
    }
    String entered = "HEX: #" + themeHexDigits;
    for (int i = themeHexDigits.length(); i < 6; i++) entered += "_";
    txt(entered, 18, 250, 1, WHITE);
    button(346, 239, 118, 24, "LOESCHEN", CARD2);
  }

  bool readable = readableColors(editBgRgb, editTextRgb);
  txt(readable ? "Kontrast OK" : "Kontrast zu gering!", 240, 273, 1,
      readable ? GREEN : RED, TC_DATUM);
  button(12, 281, 140, 32, "ZURUECK", CARD2);
  button(161, 281, 140, 32, "STANDARD", BLUE);
  button(310, 281, 158, 32, "UEBERNEHMEN", GREEN);
}

void drawColorMenu() {
  lcd.fillScreen(BG);

  txt(
    "FILAMENTFARBE AUSWAEHLEN",
    240, 14, 2, WHITE, TC_DATUM
  );

  txt(
    active().name + " " + active().material,
    240, 43, 1, GRAY, TC_DATUM
  );

  for (int i = 0; i < PALETTE_COUNT; i++) {
    int col = i % 6;
    int row = i / 6;

    int x = 17 + col * 77;
    int y = 76 + row * 66;

    uint16_t color = rgb565(PALETTE[i]);

    lcd.fillRoundRect(
      x, y, 61, 48, 8, color
    );

    if (temporaryColor == PALETTE[i]) {
      lcd.drawRoundRect(
        x - 3, y - 3,
        67, 54, 10, WHITE
      );

      lcd.drawRoundRect(
        x - 4, y - 4,
        69, 56, 10, WHITE
      );
    }
  }

  card(16, 211, 448, 39);

  lcd.fillRoundRect(
    26, 220, 32, 20, 4,
    rgb565(temporaryColor)
  );

  txt(
    colorHex(temporaryColor),
    70, 229, 2, WHITE, ML_DATUM
  );

  button(
    16, 260, 215, 49,
    "ABBRECHEN", CARD2
  );

  button(
    249, 260, 215, 49,
    "SPEICHERN", GREEN
  );
}

void openColorMenu() {
  temporaryColor = active().rgb;
  currentPage = PAGE_COLOR;
  pageDirty = true;
}

void saveSelectedColor() {
  active().rgb = temporaryColor;

  saveProfiles();

  logEvent(
    "RGB gespeichert: " +
    colorHex(active().rgb)
  );

  currentPage = PAGE_PROFILE;
  pageDirty = true;
}

void cancelColorMenu() {
  currentPage = PAGE_PROFILE;
  pageDirty = true;
}

// =====================================================
// 23. DYNAMISCHE WAAGENANZEIGE
// =====================================================


void renderScaleDynamic() {
  if (!spriteReady) return;

  // Die grossen Restgramm und der Farbwert liegen in der oberen Karte.
  sprite.fillSprite(CARD);
  String restText = zeroValid && hxReady
    ? String(restGrams, 1) + " g" : "-- g";
  spriteText(restText, 12, 4, restText.length() > 10 ? 2 : 3, WHITE);
  spriteText(stable ? "STABIL" : "MESSUNG LAEUFT", 14, 38, 1,
             stable ? GREEN : YELLOW);

  uint16_t spoolColor = rgb565(active().rgb);
  sprite.fillRoundRect(290, 3, 37, 37, 5, spoolColor);
  sprite.drawRoundRect(290, 3, 37, 37, 5, WHITE);
  String name = colorName(active().rgb);
  if (name.length() > 14) name = name.substring(0, 14);
  spriteText(name, 336, 4, name.length() > 8 ? 1 : 2, WHITE);
  spriteText(colorHex(active().rgb), 336, 32, 1, GRAY);
  pushSpriteAt(10, 99);

  // Unten links Gesamtgewicht, rechts Prozente mit schmaler Leiste.
  sprite.fillSprite(BG);
  sprite.fillRect(0, 0, 282, 52, CARD);
  sprite.fillRect(292, 0, 158, 52, CARD);
  String weightText = zeroValid && hxReady
    ? String(displayedWeightGrams(), 1) + " g" : "TARA FEHLT";
  spriteText(weightText, 141, 23, weightText.length() > 10 ? 2 : 3,
             WHITE, middle_center);
  String percentText = zeroValid && hxReady
    ? String(fillPercent, 0) + "%" : "--%";
  spriteText(percentText, 371, 21, 3, WHITE, middle_center);
  sprite.fillRoundRect(304, 44, 137, 7, 3, CARD2);
  int barWidth = (int)(137.0f * clampFloat(fillPercent, 0, 100) / 100.0f);
  if (zeroValid && hxReady && barWidth > 0)
    sprite.fillRect(304, 44, barWidth, 7, BLUE);
  pushSpriteAt(10, 199);
}


