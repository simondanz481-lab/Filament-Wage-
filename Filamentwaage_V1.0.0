  s += "<h2>Bambu Lab Cloud</h2>";

  s += "<p>Status: <b>";
  s += escapeHTML(bambuState);
  s += "</b></p>";

  s += "<p>Modell: ";
  s += escapeHTML(bambuJob);
  s += "</p>";

  s += "<p>Fortschritt: ";
  s += String(bambuProgress);
  s += " %</p>";

  s += "<p>Restzeit: ";
  s += bambuRemainingText(bambuRemaining);
  s += "</p>";

  s += "<p>Filamentanzeige: <b>";
  s += bambuViewName(bambuViewMode);
  s += "</b></p>";
  if (bambuViewMode == 0 || bambuViewMode == 2) {
    s += "<h3>AMS Lite</h3>";
    for (int i = 0; i < 4; i++) {
      s += "<p>Platz " + String(i + 1) + ": " +
        escapeHTML(slotMaterial(amsSlots[i]));
      if (amsSlots[i].colorKnown) s += " / " + colorHex(amsSlots[i].color);
      s += "</p>";
    }
  }
  if (bambuViewMode == 1 || bambuViewMode == 2) {
    s += "<h3>Externe Spule</h3><p>" + escapeHTML(slotMaterial(externalSlot));
    if (externalSlot.colorKnown) s += " / " + colorHex(externalSlot.color);
    s += "</p><p>Waagenwert (aktives Profil): ";
    s += zeroValid && hxReady ? String(restGrams, 1) + " g" : "--";
    s += "</p>";
  }
  s += "<p class='muted'>";
  s += "SN, Token und UID werden direkt ";
  s += "im Arduino-Code eingetragen.";
  s += "</p>";

  s += "</div>";
  s += htmlFoot();

  server.send(200, "text/html", s);
}

