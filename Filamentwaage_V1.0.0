void pageSettings() {
  String s = htmlHead("System");

  s += "<div class='card'>";
  s += "<h2>Heim-WLAN</h2>";

  s += "<p>Status: ";
  s += WiFi.status() == WL_CONNECTED
    ? "Verbunden"
    : "Nicht verbunden";
  s += "</p>";

