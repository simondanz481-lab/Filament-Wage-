// =====================================================
// 38. LIVE-API
// =====================================================

void pageAPI() {
  JsonDocument doc;

  doc["weight"] = displayedWeightGrams();
  doc["deduction_g"] = manualDeductionGrams;
  doc["rest"] = restGrams;
  doc["percent"] = fillPercent;
  doc["stable"] = stable;

  doc["profile"] =
    active().name + " " + active().material;

  doc["rgb"] = colorHex(active().rgb);

  doc["printing"] = printActive;
  doc["used"] = printUsed;
  doc["hybrid_status"] = hybridStatusLabel();
  doc["hybrid_provisional"] = printActive || printEndPending;
  doc["end_pending"] = printEndPending;
  doc["measurement_disturbed"] = hybridDisturbed;
  doc["last_confirmed"] = lastPrintConfirmed;
  doc["cost_eur"] = printUsed * printPriceKg / 1000.0f;
  doc["price_eur_kg"] = active().priceKg;
  doc["low_warning_grams"] = lowFilamentThreshold;
  doc["bambu_link"] = bambuConnected;
  doc["bambu_data_age_s"] = lastBambuMessage ? (millis() - lastBambuMessage) / 1000 : -1;

  doc["bambu"] = bambuState;
  doc["job"] = bambuJob;
  doc["progress"] = bambuProgress;
  doc["remaining"] = bambuRemaining; // Minutenwert fuer bestehende API-Clients
  doc["remaining_text"] = bambuRemainingText(bambuRemaining);
  doc["bambu_view"] = bambuViewName(bambuViewMode);
  doc["nozzle_temper"] = isfinite(bambuNozzleTemp) ? bambuNozzleTemp : 0;
  doc["bed_temper"] = isfinite(bambuBedTemp) ? bambuBedTemp : 0;
  doc["layer"] = bambuLayer;
  doc["layers"] = bambuTotalLayers;

  doc["enough"] = filamentEnough();

  doc["raw"] = rawValue;
  doc["zero"] = zeroOffset;
  doc["factor"] = SCALE_FACTOR;

  String json;
  serializeJson(doc, json);

  server.send(
    200,
    "application/json",
    json
  );
}

