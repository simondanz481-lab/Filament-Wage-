// =====================================================
// V1.8: Farbige Meldungsboxen (5 Sekunden; keine blockierenden delays)
// =====================================================

uint16_t noticeAccent(NoticeType type) {
  switch (type) {
    case N_LOW:      return lcd.color565(255, 194, 67);  // Warnung gelb
    case N_START:    return lcd.color565(100, 185, 255); // Info blau
    case N_END:      return lcd.color565(79, 228, 154);  // Erfolg gruen
    case N_FAILED:   return lcd.color565(255, 99, 112);  // Fehler rot
    case N_MOTION:   return lcd.color565(255, 174, 77);  // Messstoerung orange
    case N_LOST:     return lcd.color565(255, 99, 112);  // Offline rot
    case N_RESTORED: return lcd.color565(79, 228, 154);  // Online gruen
    case N_PAUSE:    return lcd.color565(255, 174, 77);  // Pause orange
    default:         return lcd.color565(100, 185, 255);
  }
}

uint16_t noticeBackground(NoticeType type) {
  switch (type) {
    case N_LOW:      return lcd.color565(65, 48, 23);
    case N_START:    return lcd.color565(24, 48, 73);
    case N_END:      return lcd.color565(22, 58, 47);
    case N_FAILED:   return lcd.color565(76, 30, 38);
    case N_MOTION:   return lcd.color565(70, 43, 29);
    case N_LOST:     return lcd.color565(76, 30, 38);
    case N_RESTORED: return lcd.color565(22, 58, 47);
    case N_PAUSE:    return lcd.color565(70, 43, 29);
    default:         return lcd.color565(24, 48, 73);
  }
}

bool noticeVisible() {
  return displayNotifications && displayNoticeUntil != 0 &&
         (int32_t)(millis() - displayNoticeUntil) < 0;
}

void drawNoticePopup() {
  if (!noticeVisible()) return;
  const int x = NOTICE_BOX_X, y = NOTICE_BOX_Y;
  const int w = NOTICE_BOX_W, h = NOTICE_BOX_H;
  const uint16_t accent = noticeAccent(displayNoticeType);
  const uint16_t panel = noticeBackground(displayNoticeType);
  const uint16_t whiteInk = lcd.color565(255, 255, 255);
  const uint16_t softInk = lcd.color565(207, 219, 233);

  // Eigene Kontrastfarben: auch bei frei waehlenbarem V1.7-Theme lesbar.
  lcd.fillRoundRect(x + 4, y + 5, w, h, 12, lcd.color565(6, 10, 17));
  lcd.fillRoundRect(x, y, w, h, 12, panel);
  lcd.drawRoundRect(x, y, w, h, 12, accent);
  lcd.fillRoundRect(x + 12, y + 13, 7, h - 26, 3, accent);
  txt(displayNotice.startsWith("TEST:") ? "TESTMELDUNG" : "FILAMENTWAAGE", x + 32, y + 13, 1, softInk);
  txt(String(noticeName(displayNoticeType)), x + 32, y + 35, 2, accent);
  lcd.drawFastHLine(x + 32, y + 66, w - 51, accent);

  // Text bis zu zwei Zeilen, nach realer Pixelbreite statt festen Zeichen.
  String remaining = displayNotice;
  remaining.replace('\n', ' ');
  remaining.replace('\r', ' ');
  remaining.trim();
  const int textWidth = w - 67;
  for (uint8_t lineNo = 0; lineNo < 2 && remaining.length(); ++lineNo) {
    lcd.setTextSize(2);
    String line = remaining;
    if (lcd.textWidth(line) > textWidth) {
      int length = line.length();
      while (length > 1 && lcd.textWidth(line.substring(0, length)) > textWidth)
        --length;
      int split = line.lastIndexOf(' ', length);
      if (split > 3) length = split;
      line = remaining.substring(0, length);
      remaining = remaining.substring(length);
      remaining.trim();
      if (lineNo == 1 && remaining.length()) {
        while (line.length() && lcd.textWidth(line + "...") > textWidth)
          line.remove(line.length() - 1);
        line += "...";
      }
    } else {
      remaining = "";
    }
    line.trim();
    txt(line, x + 32, y + 76 + 23 * lineNo, 2, whiteInk);
  }
  // Sichtbarer Schliessen-Knopf; die komplette Einblendung kann
  // ausserdem mit einem einzigen Touch geschlossen werden.
  lcd.drawRoundRect(x + w - 47, y + 13, 30, 28, 6, accent);
  txt("X", x + w - 32, y + 27, 2, whiteInk, middle_center);
  txt("Antippen zum Schliessen", x + 32, y + h - 17, 1, softInk);
}

