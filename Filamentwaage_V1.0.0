#define HX_DT 32
#define HX_SCK 25

#define TFT_SCLK 14
#define TFT_MOSI 13
#define TFT_MISO 12
#define TFT_CS 15
#define TFT_DC 2
#define TFT_LED 27
#define TOUCH_CS 33

const float SCALE_FACTOR = -365.0f;

// =====================================================
// 3. DISPLAY
// =====================================================

class LGFX : public lgfx::LGFX_Device {
  lgfx::Panel_ST7796 panel;
  lgfx::Bus_SPI bus;
  lgfx::Touch_XPT2046 touch;

public:
  LGFX() {
    {
      auto c = bus.config();
      c.spi_host = SPI2_HOST;
      c.spi_mode = 0;
      c.freq_write = 27000000;
      c.freq_read = 12000000;
      c.spi_3wire = false;
      c.use_lock = true;
      c.dma_channel = 0;
      c.pin_sclk = TFT_SCLK;
      c.pin_mosi = TFT_MOSI;
      c.pin_miso = TFT_MISO;
      c.pin_dc = TFT_DC;
      bus.config(c);
      panel.setBus(&bus);
    }

    {
      auto c = panel.config();
      c.pin_cs = TFT_CS;
      c.pin_rst = -1;
      c.pin_busy = -1;
      c.memory_width = 320;
      c.memory_height = 480;
      c.panel_width = 320;
      c.panel_height = 480;
      c.offset_x = 0;
      c.offset_y = 0;
      c.offset_rotation = 0;
      c.readable = false;
      c.invert = false;
      c.rgb_order = false;
      c.bus_shared = true;
      panel.config(c);
    }

    {
      auto c = touch.config();
      c.spi_host = SPI2_HOST;
      c.freq = 1000000;
      c.bus_shared = true;
      c.pin_sclk = TFT_SCLK;
      c.pin_mosi = TFT_MOSI;
      c.pin_miso = TFT_MISO;
      c.pin_cs = TOUCH_CS;
      c.pin_int = -1;
      c.x_min = 200;
      c.x_max = 3800;
      c.y_min = 3900;
      c.y_max = 300;
      touch.config(c);
      panel.setTouch(&touch);
    }

    setPanel(&panel);
  }
};

