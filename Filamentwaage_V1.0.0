float clampFloat(
  float value,
  float minimum,
  float maximum
) {
  return max(minimum, min(maximum, value));
}

// Nur der Anzeigewert wird korrigiert; die Rohmessung bleibt fuer
// Stabilitaetserkennung und Druckverbrauch unangetastet.
float displayedWeightGrams() {
  return max(0.0f, weightGrams - manualDeductionGrams);
}

void recalculateFilamentRemaining() {
  restGrams = max(0.0f, displayedWeightGrams() - active().emptyWeight);
  fillPercent = active().fullWeight > 0
    ? clampFloat(restGrams / active().fullWeight * 100.0f, 0, 100)
    : 0;
}

String escapeHTML(String s) {
  s.replace("&", "&amp;");
  s.replace("<", "&lt;");
  s.replace(">", "&gt;");
  s.replace("\"", "&quot;");
  s.replace("'", "&#39;");
  return s;
}

String colorHex(uint32_t rgb) {
  char buffer[8];

  snprintf(
    buffer,
    sizeof(buffer),
    "#%06lX",
    (unsigned long)(rgb & 0xFFFFFF)
  );

  return String(buffer);
}

uint32_t readHexColor(String s) {
  s.replace("#", "");

  if (s.length() != 6) {
    return 0x21C5FF;
  }

  for (char c : s) {
    if (!isxdigit((unsigned char)c)) {
      return 0x21C5FF;
    }
  }

  return strtoul(s.c_str(), nullptr, 16);
}

// NEU V1.5: Farbname aus gespeicherter RGB-Farbe

String colorName(uint32_t value) {
  value &= 0xFFFFFFUL;

  switch (value) {
    case 0xFF3B30: return "Rot";
    case 0xFF9500: return "Orange";
    case 0xFFCC00: return "Gelb";
    case 0x30D158: return "Gruen";
    case 0x00C7BE: return "Tuerkis";
    case 0x0A84FF: return "Blau";
    case 0x5E5CE6: return "Indigo";
    case 0xBF5AF2: return "Violett";
    case 0xFFFFFF: return "Weiss";
    case 0xAAAAAA: return "Grau";
    case 0x222222: return "Schwarz";
    case 0xFF69B4: return "Rosa";
    case 0x21C5FF: return "Hellblau";

    default:
      // Bei frei gewaehlten RGB-Farben
      // den exakten Hexwert anzeigen.
      return colorHex(value);
  }
}

uint16_t rgb565(uint32_t rgb) {
  return lcd.color565(
    (rgb >> 16) & 255,
    (rgb >> 8) & 255,
    rgb & 255
  );
}

// Bambu-Daten koennen in Teilmeldungen eintreffen.
// Nur empfangene Werte aktualisieren, unbekannte mit -- anzeigen.

bool parseBambuColor(String raw, uint32_t& rgbOut) {
  raw.trim();
  if (raw.startsWith("#")) raw.remove(0, 1);
  if (raw.length() != 6 && raw.length() != 8) return false;
  for (int i = 0; i < 6; i++) {
    if (!isxdigit((unsigned char)raw[i])) return false;
  }
  rgbOut = strtoul(raw.substring(0, 6).c_str(), nullptr, 16);
  return true;
}

void takeBambuTray(JsonVariantConst data, BambuFilamentSlot &slot) {
  if (data.isNull()) return;
  slot.received = true;
  if (!data["tray_type"].isNull())
    slot.material = data["tray_type"].as<String>();
  if (!data["tray_color"].isNull()) {
    String hex = data["tray_color"].as<String>();
    hex.trim();
    // RRGGBBAA: 00 Alpha bedeutet unbesetzte/unbekannte Farbe.
    if (hex.startsWith("#")) hex.remove(0, 1);
    uint32_t parsed;
    bool visibleColor = hex.length() == 6 ||
      (hex.length() == 8 && !hex.endsWith("00"));
    if (visibleColor && parseBambuColor(hex, parsed)) {
      slot.color = parsed;
      slot.colorKnown = true;
    } else {
      slot.colorKnown = false;
      slot.color = 0xAAAAAAUL;
    }
  }
}

String bambuViewName(uint8_t mode) {
  if (mode == 0) return "AMS Lite";
  if (mode == 1) return "Externe Spule";
  return "AMS + Extern";
}

String temperatureText(float actual, float target) {
  if (!isfinite(actual)) return "--";
  String result = String(actual, 0);
  if (isfinite(target)) result += "/" + String(target, 0);
  return result;
}

String slotMaterial(const BambuFilamentSlot &slot) {
  if (!slot.received || slot.material.isEmpty()) return "--";
  return slot.material;
}

void logEvent(String message); // Forward-Deklaration

// =====================================================
// DISPLAY: Helligkeit, Schlafmodus, hell/dunkel, Hinweise
// =====================================================

// -----------------------------------------------------
// V1.7 Farbanpassung: RGB565, Kontrast und Farb-Mischung
// -----------------------------------------------------
uint32_t mixRgb(uint32_t from, uint32_t to, uint8_t toPercent) {
  uint32_t out = 0;
  for (int shift = 0; shift <= 16; shift += 8) {
    uint32_t a = (from >> shift) & 255U;
    uint32_t b = (to >> shift) & 255U;
    uint32_t ch = (a * (100U - toPercent) + b * toPercent) / 100U;
    out |= ch << shift;
  }
  return out & 0xFFFFFFUL;
}

float linearRgbChannel(uint8_t raw) {
  float c = raw / 255.0f;
  return c <= 0.04045f ? c / 12.92f : powf((c + 0.055f) / 1.055f, 2.4f);
}

float rgbLuminance(uint32_t rgb) {
  return 0.2126f * linearRgbChannel((rgb >> 16) & 255) +
         0.7152f * linearRgbChannel((rgb >> 8) & 255) +
         0.0722f * linearRgbChannel(rgb & 255);
}

bool readableColors(uint32_t background, uint32_t foreground) {
  float b = rgbLuminance(background), t = rgbLuminance(foreground);
  float hi = max(b, t), lo = min(b, t);
  // Kleine Schrift auf TFT: mindestens ca. 7:1, auch fuer Karten.
  return (hi + 0.05f) / (lo + 0.05f) >= 7.0f;
}

uint32_t defaultBackgroundRgb(bool dark) {
  return dark ? 0x080C10UL : 0xE2ECF6UL;
}
uint32_t defaultTextRgb(bool dark) {
  return dark ? 0xFFFFFFUL : 0x162F4AUL;
}

void updatePendingColorDefaults() {
  if (!pendingCustomColors) {
    pendingBgRgb = defaultBackgroundRgb(pendingDarkMode);
    pendingTextRgb = defaultTextRgb(pendingDarkMode);
  }
}

uint32_t setColorComponent(uint32_t rgb, uint8_t channel, int delta) {
  int shift = channel == 0 ? 16 : (channel == 1 ? 8 : 0);
  int oldValue = (rgb >> shift) & 255;
  int nextValue = constrain(oldValue + delta, 0, 255);
  return (rgb & ~(0xFFUL << shift)) | ((uint32_t)nextValue << shift);
}

void applyDisplayTheme() {
  if (displayDarkMode) {
    BG = 0x0862; CARD = 0x1925; CARD2 = 0x2945;
    WHITE = 0xFFFF; GRAY = 0xBDF7;
    GREEN = 0x3666; BLUE = 0x2C9F;
    RED = 0xF986; YELLOW = 0xFE20;
  } else {
    BG = lcd.color565(226, 236, 246);
    CARD = lcd.color565(250, 252, 255);
    CARD2 = lcd.color565(202, 219, 237);
    WHITE = lcd.color565(22, 47, 74);
    GRAY = lcd.color565(80, 104, 130);
    GREEN = lcd.color565(20, 145, 90);
    BLUE = lcd.color565(40, 147, 231);
    RED = lcd.color565(208, 66, 69);
    YELLOW = lcd.color565(170, 111, 0);
  }
  if (customColorsEnabled) {
    BG = rgb565(customBgRgb);
    WHITE = rgb565(customTextRgb);
    // Karten minimal in Richtung Schriftfarbe absetzen.
    CARD = rgb565(mixRgb(customBgRgb, customTextRgb, 9));
    CARD2 = rgb565(mixRgb(customBgRgb, customTextRgb, 17));
    GRAY = rgb565(mixRgb(customTextRgb, customBgRgb, 30));
  }
}

void setDisplayBacklight() {
  // Der laufende ESP32 wird nicht schlafen gelegt:
  // WLAN, Messung und MQTT bleiben beim Timeout aktiv.
  int duty = displayAwake ? (int)displayBrightness * 255 / 100 : 0;
  analogWrite(TFT_LED, duty);
}

void maintainDisplayTimeout() {
  if (!displayAwake || displayTimeoutChoice == 0) return;
  const unsigned long duration =
    (unsigned long)DISPLAY_TIMEOUT_MINUTES[displayTimeoutChoice] * 60000UL;
  if (millis() - lastDisplayInteraction >= duration) {
    displayAwake = false;
    setDisplayBacklight();
  }
}

void notifyDisplay(const String &message) {
  if (!displayNotifications) return;
  displayNotice = message.substring(0, 120);
  displayNoticeType = N_START; // Universeller alter Hinweis ohne Ereignistyp.
  displayNoticeUntil = millis() + 5000UL;
  noticePopupDrawn = false;
  pageDirty = true;
}

String timeoutLabel(uint8_t which) {
  if (which == 0) return "Nie";
  return String(DISPLAY_TIMEOUT_MINUTES[which]) + " Minuten";
}

void saveDisplayPrefs() {
  // Verhindert unlesbare Beschriftungen.
  if (pendingCustomColors && !readableColors(pendingBgRgb, pendingTextRgb)) {
    logEvent("Display-Farben: Kontrast zu gering");
    return;
  }
  displayBrightness = pendingBrightness;
  displayTimeoutChoice = pendingTimeoutChoice;
  displayDarkMode = pendingDarkMode;
  displayNotifications = pendingNotifications;
  customColorsEnabled = pendingCustomColors;
  customBgRgb = pendingBgRgb & 0xFFFFFFUL;
  customTextRgb = pendingTextRgb & 0xFFFFFFUL;
  prefs.putUChar("dBright", displayBrightness);
  prefs.putUChar("dTime", displayTimeoutChoice);
  prefs.putBool("dDark", displayDarkMode);
  prefs.putBool("dNotice", displayNotifications);
  prefs.putBool("custClr", customColorsEnabled);
  prefs.putUInt("bgRGB", customBgRgb);
  prefs.putUInt("txRGB", customTextRgb);
  applyDisplayTheme();
  displayAwake = true;
  lastDisplayInteraction = millis();
  setDisplayBacklight();
  logEvent("V1.0.0 Anzeigeeinstellungen gespeichert");
  currentPage = PAGE_SYSTEM;
  pageDirty = true;
}

void openDisplaySettings() {
  pendingBrightness = displayBrightness;
  pendingTimeoutChoice = displayTimeoutChoice;
  pendingDarkMode = displayDarkMode;
  pendingNotifications = displayNotifications;
  pendingCustomColors = customColorsEnabled;
  pendingBgRgb = customBgRgb;
  pendingTextRgb = customTextRgb;
  updatePendingColorDefaults();
  currentPage = PAGE_DISPLAY_SETTINGS;
  pageDirty = true;
}

String durationText(uint32_t seconds) {
  return String(seconds / 3600) + "h " +
         String((seconds % 3600) / 60) + "m";
}

// Bambu sendet die Restzeit in Minuten. Einheitlich als h und min anzeigen.
String bambuRemainingText(int minutes) {
  if (minutes < 0) return "--";
  int hours = minutes / 60;
  int mins = minutes % 60;
  return String(hours) + " h " + (mins < 10 ? "0" : "") + String(mins) + " min";
}

String timestamp() {
  struct tm t;

  if (getLocalTime(&t, 10)) {
    char buffer[24];

    strftime(
      buffer,
      sizeof(buffer),
      "%d.%m.%Y %H:%M",
      &t
    );

    return String(buffer);
  }

  return "Ohne Datum";
}

void logEvent(String message) {
  Serial.println(message);

  logLines[logNext] =
    timestamp() + " | " + message;

  logNext = (logNext + 1) % MAX_LOGS;
}

const char* noticeName(NoticeType type) {
  switch (type) {
    case N_LOW: return "Filament niedrig";
    case N_START: return "Druck gestartet";
    case N_END: return "Druck abgeschlossen";
    case N_FAILED: return "Druck fehlgeschlagen";
    case N_MOTION: return "Messstoerung";
    case N_LOST: return "Verbindung verloren";
    case N_RESTORED: return "Verbindung hergestellt";
    case N_PAUSE: return "Druck pausiert";
    default: return "Meldung";
  }
}
void emitNotice(NoticeType type, const String &message) {
  logEvent(String("Meldung [") + noticeName(type) + "]: " + message);
  uint16_t bit = (uint16_t)1U << (uint8_t)type;
  if (displayNotifications && (noticeDisplayMask & bit)) {
    displayNotice = message.substring(0, 120);
    displayNoticeType = type;
    displayNoticeUntil = millis() + 5000UL;
    noticePopupDrawn = false;
    pageDirty = true;
  }
  if (noticeWebMask & bit) {
    for (uint8_t i = min((int)noticeCount, (int)MAX_NOTICES - 1); i > 0; --i)
      noticeRecords[i] = noticeRecords[i - 1];
    noticeRecords[0] = {++noticeSequence, type, message, timestamp()};
    if (noticeCount < MAX_NOTICES) ++noticeCount;
  }
}
void saveV18Settings() {
  prefs.putUInt("ntDMask", noticeDisplayMask);
  prefs.putUInt("ntWMask", noticeWebMask);
  prefs.putFloat("lowGram", lowFilamentThreshold);
}


void redirect(String path) {
  server.sendHeader("Location", path);
  server.send(303, "text/plain", "");
}

bool checkLogin() {
  if (server.authenticate(WEB_USER, WEB_PASS)) {
    return true;
  }

  server.requestAuthentication(
    BASIC_AUTH,
    "Filamentwaage V1.0.0",
    "Bitte Benutzername und Passwort eingeben"
  );

  return false;
}

String currentIP() {
  if (WiFi.status() == WL_CONNECTED) {
    return WiFi.localIP().toString();
  }

  return "OFFLINE";
}

// =====================================================
// 12. PROFILE LADEN UND SPEICHERN
// =====================================================

void defaultProfiles() {
  profileCount = 1;
  activeProfile = 0;

  profiles[0].name = "Geeetech";
  profiles[0].material = "PLA";
  profiles[0].emptyWeight = 170.0f;
  profiles[0].fullWeight = 1000.0f;
  profiles[0].rgb = 0x21C5FF;
  profiles[0].priceKg = 0;
}

void saveProfiles() {
  prefs.putUInt("pc", profileCount);
  prefs.putUInt("pa", activeProfile);

  for (int i = 0; i < MAX_PROFILES; i++) {
    String key = "p" + String(i);

    if (i >= profileCount) {
      prefs.remove(key.c_str());
      continue;
    }

    JsonDocument doc;

    doc["n"] = profiles[i].name;
    doc["m"] = profiles[i].material;
    doc["e"] = profiles[i].emptyWeight;
    doc["f"] = profiles[i].fullWeight;
    doc["rgb"] = profiles[i].rgb;
    doc["price"] = profiles[i].priceKg;

    String json;
    serializeJson(doc, json);

    prefs.putString(key.c_str(), json);
  }
}

void loadProfiles() {
  profileCount = prefs.getUInt("pc", 0);

  if (profileCount < 1 ||
      profileCount > MAX_PROFILES) {
    defaultProfiles();
    saveProfiles();
    return;
  }

  for (int i = 0; i < profileCount; i++) {
    JsonDocument doc;

    String json = prefs.getString(
      ("p" + String(i)).c_str(),
      ""
    );

    if (deserializeJson(doc, json)) {
      defaultProfiles();
      saveProfiles();
      return;
    }

    profiles[i].name = doc["n"].as<String>();
    profiles[i].material = doc["m"].as<String>();
    profiles[i].emptyWeight = doc["e"] | 170.0f;
    profiles[i].fullWeight = doc["f"] | 1000.0f;
    profiles[i].rgb = doc["rgb"] | 0x21C5FF;
    profiles[i].priceKg = clampFloat(doc["price"] | 0.0f, 0, 1000);
  }

  activeProfile = constrain(
    (int)prefs.getUInt("pa", 0),
    0,
    profileCount - 1
  );
}

void changeProfile(int direction) {
  activeProfile += direction;

  if (activeProfile < 0) {
    activeProfile = profileCount - 1;
  }

  if (activeProfile >= profileCount) {
    activeProfile = 0;
  }

  prefs.putUInt("pa", activeProfile);
  warnedLow = false;
  if (printActive || printEndPending) hybridMajorDisturbance = true;
  pageDirty = true;
}

// =====================================================
// 13. ARCHIV LADEN UND SPEICHERN
// =====================================================

void saveHistory() {
  prefs.putUInt("hc", historyCount);

  for (int i = 0; i < historyCount; i++) {
    JsonDocument doc;

    doc["d"] = historyItems[i].date;
    doc["n"] = historyItems[i].name;
    doc["f"] = historyItems[i].filament;
    doc["u"] = historyItems[i].used;
    doc["sw"] = historyItems[i].startWeight;
    doc["ew"] = historyItems[i].endWeight;
    doc["t"] = historyItems[i].seconds;
    doc["cost"] = historyItems[i].cost;
    doc["ok"] = historyItems[i].confirmed;

    String json;
    serializeJson(doc, json);

    prefs.putString(
      ("h" + String(i)).c_str(),
      json
    );
  }
}

void loadHistory() {
  historyCount = constrain(
    (int)prefs.getUInt("hc", 0),
    0,
    MAX_HISTORY
  );

  for (int i = 0; i < historyCount; i++) {
    JsonDocument doc;

    deserializeJson(
      doc,
      prefs.getString(
        ("h" + String(i)).c_str(),
        ""
      )
    );

    historyItems[i].date = doc["d"].as<String>();
    historyItems[i].name = doc["n"].as<String>();
    historyItems[i].filament = doc["f"].as<String>();
    historyItems[i].used = doc["u"] | 0.0f;
    historyItems[i].startWeight = doc["sw"] | 0.0f;
    historyItems[i].endWeight = doc["ew"] | 0.0f;
    historyItems[i].seconds = doc["t"] | 0UL;
    historyItems[i].cost = clampFloat(doc["cost"] | 0.0f, 0, 5000);
    historyItems[i].confirmed = doc["ok"] | false; // V1.7: keine bestaetigte Hybrid-Endmessung
  }
}

void archivePrint(
  String name,
  float used,
  float startWeight,
  float endWeight,
  uint32_t seconds,
  float cost,
  bool confirmed,
  String filamentLabel
) {
  for (
    int i = min(historyCount, MAX_HISTORY - 1);
    i > 0;
    i--
  ) {
    historyItems[i] = historyItems[i - 1];
  }

  historyItems[0].date = timestamp();
  historyItems[0].name = name;

  historyItems[0].filament = filamentLabel;

  historyItems[0].used = used;
  historyItems[0].startWeight = startWeight;
  historyItems[0].endWeight = endWeight;
  historyItems[0].seconds = seconds;
  historyItems[0].cost = cost;
  historyItems[0].confirmed = confirmed;

  historyCount = min(
    historyCount + 1,
    MAX_HISTORY
  );

  saveHistory();
}

// =====================================================
// 14. HX711
// =====================================================

bool readRawAverage(
  long& value,
  int count
) {
  if (!scale.wait_ready_timeout(1200)) {
    return false;
  }

  value = scale.read_average(count);
  return true;
}

bool tareScale() {
  long value;

  if (!readRawAverage(value, 15)) {
    logEvent("Tara fehlgeschlagen");
    return false;
  }

  zeroOffset = value;
  zeroValid = true;

  prefs.putLong("zero", zeroOffset);
  prefs.putBool("zeroOK", true);

  filterReady = false;
  recentCount = 0;
  recentIndex = 0;
  stable = false;
  lastStableAt = 0;
  if (printActive || printEndPending) {
    // Eine Tara waehrend eines Drucks invalidiert die Vergleichsgrundlage.
    printStartStable = false;
    hybridMajorDisturbance = true;
    hybridDisturbed = true;
  }

  pageDirty = true;

  logEvent(
    "Nullpunkt gespeichert: " +
    String(zeroOffset)
  );

  return true;
}

void initScale() {
  scale.begin(HX_DT, HX_SCK);
  scale.set_gain(128);

  zeroValid = prefs.getBool("zeroOK", false);

  if (zeroValid) {
    zeroOffset = prefs.getLong("zero", 0);

    logEvent(
      "Nullpunkt geladen: " +
      String(zeroOffset)
    );
  } else {
    // NEU V1.5:
    // Keine automatische Tara beim Hochfahren.
    logEvent(
      "Nullpunkt fehlt: Bitte Waage leer tarieren"
    );
  }

  logEvent("Kalibrierfaktor: -365.0 FIX");
}

void updateScale() {
  if (millis() - lastScaleAt < 180) {
    return;
  }

  lastScaleAt = millis();

  if (!scale.is_ready()) {
    if (millis() - lastScaleOK > 2000) {
      hxReady = false;
    }
    return;
  }

  long value;

  if (!readRawAverage(value, 3)) {
    return;
  }

  rawValue = value;
  hxReady = true;
  lastScaleOK = millis();

  if (!zeroValid) {
    return;
  }

  float grams =
    ((float)rawValue - zeroOffset) /
    SCALE_FACTOR;

  if (!filterReady) {
    filteredWeight = grams;
    filterReady = true;
  } else {
    float difference =
      fabsf(grams - filteredWeight);

    if (difference > 5500.0f) {
      if (printActive || printEndPending) {
        hybridDisturbed = true;
        hybridMajorDisturbance = true;
      }
      return;
    }

    float alpha =
      difference > 20.0f ? 0.65f : 0.25f;

    filteredWeight =
      (1.0f - alpha) * filteredWeight +
      alpha * grams;
  }

  weightGrams = filteredWeight;

  if (fabsf(weightGrams) < 0.25f) {
    weightGrams = 0;
  }

  recent[recentIndex] = weightGrams;
  recentIndex = (recentIndex + 1) % 8;

  if (recentCount < 8) {
    recentCount++;
  }

  float low = weightGrams;
  float high = weightGrams;

  for (int i = 0; i < recentCount; i++) {
    low = min(low, recent[i]);
    high = max(high, recent[i]);
  }

  stable =
    recentCount == 8 &&
    high - low < 1.5f;

  if (stable) {
    lastStableWeight = weightGrams;
    lastStableAt = millis();
  }

  // Zusaetzlicher Web-Abzug wirkt auf Gesamtgewicht, Rest und Fuellstand.
  // Der HX711-Messwert bleibt unveraendert fuer die Hybridmessung.
  recalculateFilamentRemaining();

  if (printActive) {
    printDuration = (millis() - printStartMillis) / 1000;
  }
  updateHybrid(grams, high - low);
  monitorLowFilament();
}

// =====================================================
// 15. DRUCKMESSUNG
// =====================================================

void startPrint(bool automatic) {
  if (printActive || printEndPending || !hxReady || !zeroValid) return;
  printActive = true;
  printAutomatic = automatic;
  // Stabiler Messwert nur nutzbar, wenn er wirklich frisch ist.
  printStartStable = stable && (millis() - lastStableAt < 5000UL);
  printStartWeight = printStartStable ? lastStableWeight : weightGrams;
  hybridProvisional = 0;
  hybridGoodSamples = 0;
  hybridLastRaw = printStartWeight;
  hybridDisturbed = !printStartStable;
  hybridMajorDisturbance = false;
  printEndedFailed = false;
  hybridDisturbedUntil = 0;
  hybridLastValidAt = 0;
  printUsed = 0;
  printStartMillis = millis();
  printDuration = 0;
  printName = bambuJob.length() ? bambuJob : "Manueller Druck";
  printFilamentLabel = active().name + " " + active().material;
  printPriceKg = active().priceKg;
  warnedLow = false;
  logEvent("Druck gestartet: " + printName + (printStartStable ? "" : " (Startwert vorlaeufig)"));
  emitNotice(N_START, "DRUCK GESTARTET");
  pageDirty = true;
}

// Benutzer-STOP und Bambu-Ende starten zuerst eine ruhige Endmessung.
void stopPrint(bool failed = false) {
  if (!printActive) return;
  printEndedFailed = failed;
  printDuration = (millis() - printStartMillis) / 1000;
  printActive = false;
  printAutomatic = false;
  printEndPending = true;
  printEndRequestedAt = millis();
  printEndQuietSince = 0;
  logEvent("Druckende erkannt; warte auf stabile Endmessung");
  pageDirty = true;
}

// Geruehrte Spule / Zug: vorlaeufiger Verbrauch wird nicht weiter hochgerechnet.
void updateHybrid(float rawGrams, float windowSpan) {
  if (!printActive && !printEndPending) {
    hybridLastRaw = rawGrams;
    return;
  }
  float rawStep = isfinite(hybridLastRaw) ? fabsf(rawGrams - hybridLastRaw) : 0.0f;
  bool jump = rawStep > 6.0f;
  hybridLastRaw = rawGrams;
  bool motion = jump || windowSpan > 3.5f ||
                fabsf(rawGrams - weightGrams) > 7.0f;
  if (motion) {
    if (rawStep > 25.0f || windowSpan > 25.0f) {
      // Bei Spulenwechsel / massivem Zug kann die Endmessung nicht bestaetigt werden.
      hybridMajorDisturbance = true;
    }
    if (!hybridDisturbed) emitNotice(N_MOTION, "MESSSTOERUNG ERKANNT");
    hybridDisturbed = true;
    hybridDisturbedUntil = millis() + 2500UL;
    hybridGoodSamples = 0;
  } else if (hybridDisturbed &&
             (int32_t)(millis() - hybridDisturbedUntil) >= 0) {
    // Erst mehrere unauffaellige Messungen erlauben erneut Live-Updates.
    if (++hybridGoodSamples >= 5) {
      hybridDisturbed = false;
      hybridGoodSamples = 0;
    }
  }
  if (!hybridDisturbed && hxReady && zeroValid) {
    hybridLastValidAt = millis();
    if (printActive) {
      float measured = printStartWeight - weightGrams;
      if (isfinite(measured) && measured >= -5 && measured < 5000.0f) {
        measured = max(0.0f, measured);
        hybridProvisional = 0.78f * hybridProvisional + 0.22f * measured;
        printUsed = hybridProvisional;
      }
    }
  }
  if (printEndPending) {
    if (stable && !hybridDisturbed &&
        (int32_t)(millis() - hybridDisturbedUntil) >= 0) {
      if (printEndQuietSince == 0) printEndQuietSince = millis();
    } else {
      printEndQuietSince = 0;
    }
  }
}

void serviceHybridFinal() {
  if (!printEndPending) return;
  const bool timedOut = millis() - printEndRequestedAt > 90000UL;
  const bool quiet = printEndQuietSince &&
                     millis() - printEndQuietSince >= 3500UL &&
                     lastStableAt >= printEndRequestedAt &&
                     millis() - lastStableAt < 1200UL;
  if (!quiet && !timedOut) return;
  float endWeight = quiet ? lastStableWeight : weightGrams;
  float delta = printStartWeight - endWeight;
  bool good = quiet && printStartStable && !hybridMajorDisturbance &&
              hxReady && zeroValid && isfinite(delta) && delta >= -2.0f &&
              delta <= min(5000.0f, active().fullWeight + 300.0f);
  float consumed = good ? max(0.0f, delta) : clampFloat(printUsed, 0, 5000);
  float cost = (printPriceKg > 0) ? consumed * printPriceKg / 1000.0f : 0;
  printUsed = consumed;
  lastPrintConfirmed = good;
  archivePrint(printName, consumed, printStartWeight, endWeight,
               printDuration, cost, good, printFilamentLabel);
  printEndPending = false;
  logEvent(String("Druck archiviert: ") + String(consumed, 1) + " g (" +
           (good ? "Endmessung bestaetigt" : "vorlaeufig / Messung unsicher") + ")");
  emitNotice(N_END, String(printEndedFailed ? "DRUCK FEHLER: " :
                  (good ? "DRUCK FERTIG: " : "DRUCK VORLAEUFIG: ")) +
            String(consumed, 1) + " g / " + String(cost, 2) + " EUR");
  pageDirty = true;
}

void monitorLowFilament() {
  if (!printActive || !stable || !zeroValid || !hxReady ||
      lowFilamentThreshold <= 0 || hybridDisturbed) return;
  if (!warnedLow && restGrams > 1.0f && restGrams <= lowFilamentThreshold) {
    warnedLow = true;
    emitNotice(N_LOW, "FILAMENT NIEDRIG: " + String(restGrams, 0) + " g");
  } else if (warnedLow && restGrams > lowFilamentThreshold + 15.0f) {
    warnedLow = false;
  }
}

String hybridStatusLabel() {
  if (printEndPending) return "ENDMESSUNG";
  if (printActive && hybridDisturbed) return "GESTOERT";
  if (printActive) return printStartStable ? "LIVE VORLAEUFIG" : "START UNGEWISS";
  return lastPrintConfirmed ? "ENDE BESTAETIGT" : "BEREIT";
}

String filamentEnough() {
  if (expectedGrams <= 0) {
    return "KEINE MENGE EINGETRAGEN";
  }

  return restGrams >= expectedGrams
    ? "JA"
    : "NEIN";
}

// =====================================================
// 16. WLAN
// =====================================================

void connectWiFi() {
  logEvent("Verbinde mit Heim-WLAN...");

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);

  WiFi.begin(WIFI_SSID, WIFI_PASS);

  unsigned long started = millis();

  while (
    WiFi.status() != WL_CONNECTED &&
    millis() - started < 15000
  ) {
    delay(250);
  }

  if (WiFi.status() == WL_CONNECTED) {
    wifiWasConnected = true;

    logEvent(
      "WLAN verbunden: http://" +
      WiFi.localIP().toString()
    );

    configTzTime(
      "CET-1CEST,M3.5.0,M10.5.0/3",
      "pool.ntp.org",
      "time.google.com"
    );
  } else {
    logEvent("WLAN nicht erreichbar");
  }

  lastWifiAttempt = millis();
}

void maintainWiFi() {
  bool connected =
    WiFi.status() == WL_CONNECTED;

  if (connected) {
    if (!wifiWasConnected) {
      logEvent(
        "WLAN wieder verbunden: " +
        currentIP()
      );
      pageDirty = true;
    }

    wifiWasConnected = true;
    return;
  }

  if (wifiWasConnected) {
    wifiWasConnected = false;
    logEvent("WLAN-Verbindung verloren");
    pageDirty = true;
  }

  if (millis() - lastWifiAttempt < 20000) {
    return;
  }

  lastWifiAttempt = millis();

  WiFi.disconnect(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
}

// =====================================================
// 17. BAMBU CLOUD
// =====================================================

bool bambuConfigured() {
  return
    String(BAMBU_SN) != "DEINE_SERIENNUMMER" &&
    String(BAMBU_TOKEN) != "DEIN_ACCESS_TOKEN" &&
    String(BAMBU_UID) != "DEINE_UID" &&
    strlen(BAMBU_SN) > 0 &&
    strlen(BAMBU_TOKEN) > 0 &&
    strlen(BAMBU_UID) > 0;
}

void onBambuMessage(
  char* topic,
  byte* payload,
  unsigned int length
) {
  JsonDocument doc;

  if (deserializeJson(doc, payload, length)) {
    return;
  }

  JsonVariant p = doc["print"];

  if (p.isNull()) {
    return;
  }

  lastBambuMessage = millis();
  mqttStaleReported = false;

  // Drucktemperaturen / Schichtinformation
  if (!p["nozzle_temper"].isNull())
    bambuNozzleTemp = p["nozzle_temper"].as<float>();
  if (!p["nozzle_target_temper"].isNull())
    bambuNozzleTarget = p["nozzle_target_temper"].as<float>();
  if (!p["bed_temper"].isNull())
    bambuBedTemp = p["bed_temper"].as<float>();
  if (!p["bed_target_temper"].isNull())
    bambuBedTarget = p["bed_target_temper"].as<float>();
  if (!p["layer_num"].isNull())
    bambuLayer = p["layer_num"].as<int>();
  if (!p["total_layer_num"].isNull())
    bambuTotalLayers = p["total_layer_num"].as<int>();
  if (!p["print_error"].isNull()) {
    uint32_t nextError = p["print_error"].as<uint32_t>();
    if (nextError != 0 && nextError != bambuError) {
      emitNotice(N_FAILED, "DRUCKERFEHLER");
    }
    bambuError = nextError;
  }

  // AMS Lite: Array mit einer Einheit und vier Trays.
  // Teilmeldungen ohne AMS-Daten ueberschreiben nichts.
  JsonVariantConst ams = p["ams"];
  if (!ams.isNull() && ams["ams"].is<JsonArray>()) {
    JsonArrayConst units = ams["ams"].as<JsonArrayConst>();
    for (JsonVariantConst unit : units) {
      int unitId = unit["id"].as<String>().toInt();
      if (unitId != 0 || !unit["tray"].is<JsonArray>()) continue;
      for (JsonVariantConst tray : unit["tray"].as<JsonArrayConst>()) {
        int id = tray["id"].as<String>().toInt();
        if (id >= 0 && id < 4) takeBambuTray(tray, amsSlots[id]);
      }
    }
  }

  // A1 Mini: externe Spule als vt_tray; vir_slot bei
  // neueren Meldungen ebenfalls unterstuetzen.
  JsonVariantConst virtualTrays = p["vir_slot"];
  if (virtualTrays.is<JsonArray>()) {
    for (JsonVariantConst slot : virtualTrays.as<JsonArrayConst>()) {
      int id = slot["id"].as<String>().toInt();
      if (id == 254 || id == 255) {
        takeBambuTray(slot, externalSlot);
        break;
      }
    }
  } else {
    JsonVariantConst vt = p["vt_tray"];
    if (!vt.isNull()) takeBambuTray(vt, externalSlot);
  }

  if (!p["subtask_name"].isNull()) {
    String name =
      p["subtask_name"].as<String>();

    if (name.length()) {
      bambuJob = name;
    }
  }

  if (!p["mc_percent"].isNull()) {
    bambuProgress = constrain(
      p["mc_percent"].as<int>(),
      0,
      100
    );
  }

  if (!p["mc_remaining_time"].isNull()) {
    bambuRemaining =
      p["mc_remaining_time"].as<int>();
  }

  if (!p["gcode_state"].isNull()) {
    String next =
      p["gcode_state"].as<String>();

    next.toUpperCase();

    String old = bambuState;
    bambuState = next;
    if (next != old) {
      if (next == "FAILED") emitNotice(N_FAILED, "DRUCK FEHLER");
      else if (next == "PAUSE") emitNotice(N_PAUSE, "DRUCK PAUSIERT");
    }

    if (
      bambuStateKnown &&
      next == "RUNNING" &&
      old != "RUNNING" &&
      old != "PAUSE"
    ) {
      // Wird ein neuer Druck waehrend einer alten Endmessung gestartet,
      // die vorige Messung als unsicher abschliessen und nicht verlieren.
      if (printEndPending) {
        printEndRequestedAt = millis() - 91000UL;
        serviceHybridFinal();
      }
      startPrint(true);
    }

    if (next == "FINISH" && old != "FINISH" && !printActive &&
        !printEndPending && bambuStateKnown) {
      emitNotice(N_END, "BAMBU DRUCK FERTIG (OHNE WAAGENMESSUNG)");
    }
    if (
      printActive &&
      printAutomatic &&
      (
        next == "FINISH" ||
        next == "FAILED" ||
        next == "IDLE"
      )
    ) {
      stopPrint(next == "FAILED");
    }

    bambuStateKnown = true;
  }
}

void connectBambu() {
  if (!bambuConfigured()) {
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  if (mqtt.connected()) {
    return;
  }

  if (millis() - lastMQTTAttempt < 20000) {
    return;
  }

  lastMQTTAttempt = millis();

  String mqttUser =
    "u_" + String(BAMBU_UID);

  String clientID =
    "FWV18-" +
    String(
      (uint32_t)ESP.getEfuseMac(),
      HEX
    );

  logEvent("Verbinde Bambu Cloud...");

  bool success = mqtt.connect(
    clientID.c_str(),
    mqttUser.c_str(),
    BAMBU_TOKEN
  );

  if (success) {
    String topic =
      "device/" +
      String(BAMBU_SN) +
      "/report";

    mqtt.subscribe(topic.c_str());

    bambuConnected = true;
    if (bambuLinkWasDown && everBambuConnected) emitNotice(N_RESTORED, "BAMBU WIEDER VERBUNDEN");
    everBambuConnected = true;
    bambuLinkWasDown = false;
    mqttStaleReported = false;
    bambuStateKnown = false;
    bambuState = "VERBUNDEN";

    logEvent("Bambu Cloud verbunden");
  } else {
    bambuConnected = false;
    bambuState = "OFFLINE";

    logEvent(
      "MQTT Fehler: " +
      String(mqtt.state())
    );
  }

  pageDirty = true;
}

void maintainBambu() {
  if (!bambuConfigured()) {
    bambuState = "NICHT EINGERICHTET";
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    if (bambuConnected) {
      bambuLinkWasDown = true;
      emitNotice(N_LOST, "WLAN / BAMBU OFFLINE");
    }
    bambuConnected = false;
    bambuState = "OFFLINE";
    return;
  }

  if (!mqtt.connected()) {
    if (bambuConnected) {
      bambuConnected = false;
      bambuLinkWasDown = true;
      emitNotice(N_LOST, "BAMBU VERBINDUNG VERLOREN");
      bambuState = "OFFLINE";
      pageDirty = true;
    }

    connectBambu();
  } else {
    mqtt.loop();
    // MQTT kann online sein, obwohl laengere Zeit keine Druckdaten kommen.
    // Dies wird nur als "Daten alt" protokolliert, nicht als Netzabbruch.
    if (lastBambuMessage && millis() - lastBambuMessage > 180000UL && !mqttStaleReported) {
      mqttStaleReported = true;
      logEvent("Bambu: seit 180 s keine Druckdaten (MQTT verbunden)");
    }
  }
}

// =====================================================
// 18. ZEICHENFUNKTIONEN
// =====================================================

void txt(
  String s,
  int x,
  int y,
  int size,
  uint16_t color,
  uint8_t datum = TL_DATUM
) {
  lcd.setTextDatum(datum);
  lcd.setTextSize(size);
  lcd.setTextColor(color);
  lcd.drawString(s, x, y);
}

void card(
  int x,
  int y,
  int w,
  int h,
  uint16_t color = CARD
) {
  lcd.fillRoundRect(
    x, y, w, h, 9, color
  );
}

void button(
  int x,
  int y,
  int w,
  int h,
  String label,
  uint16_t color
) {
  card(x, y, w, h, color);

  uint16_t buttonInk = (color == BLUE || color == GREEN || color == RED)
    ? 0xFFFF : WHITE;
  txt(
    label,
    x + w / 2,
    y + h / 2,
    1,
    buttonInk,
    middle_center
  );
}

void bar(
  int x,
  int y,
  int w,
  int h,
  float percent,
  uint16_t color
) {
  lcd.fillRoundRect(
    x, y, w, h, 5, CARD2
  );

  int filled =
    (int)(
      w *
      clampFloat(percent, 0, 100) /
      100
    );

  if (filled > 0) {
    lcd.fillRoundRect(
      x, y, filled, h, 5, color
    );
  }
}

void spriteText(
  String s,
  int x,
  int y,
  int size,
  uint16_t color,
  uint8_t datum = TL_DATUM
) {
  sprite.setTextDatum(datum);
  sprite.setTextSize(size);
  sprite.setTextColor(color);
  sprite.drawString(s, x, y);
}

void pushSpriteAt(int x, int y) {
  if (spriteReady) {
    sprite.pushSprite(x, y);
  }
}

