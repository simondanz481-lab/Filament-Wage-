  s += "</div>";
  s += "<div class='card'><h2>Kosten / Endmessungen (letzte 12 Drucke)</h2>";
  s += "<p>Gesamtkosten: <b>" + String(totalCost, 2) + " EUR</b></p>";
  s += "<p>Durchschnittsverbrauch: <b>" + String(historyCount ? totalUsed / historyCount : 0, 1) + " g</b></p>";
  s += "<p>Bestaetigte Hybrid-Endmessungen: <b>" + String(confirmedCount) + "</b></p>";
  s += "<p class='small muted'>Das Archiv speichert bis zu 12 Drucke; keine unbegrenzte Lebenszeitstatistik.</p></div>";

  s += "<div class='card'>";
  s += "<h2>Druckarchiv</h2>";

  s += "<a class='link' href='/history.csv'>";
  s += "CSV herunterladen";
  s += "</a>";

  s += "<div class='scroll'><table>";

  s += "<tr>";
  s += "<th>Datum</th>";
  s += "<th>Modell</th>";
  s += "<th>Filament</th>";
  s += "<th>Verbrauch</th>";
  s += "<th>Dauer</th><th>Kosten</th><th>Messung</th>";
  s += "</tr>";

  for (int i = 0; i < historyCount; i++) {
    s += "<tr><td>";
    s += escapeHTML(historyItems[i].date);

    s += "</td><td>";
    s += escapeHTML(historyItems[i].name);

    s += "</td><td>";
    s += escapeHTML(historyItems[i].filament);

    s += "</td><td>";
    s += String(historyItems[i].used, 1);

    s += " g</td><td>";
    s += durationText(historyItems[i].seconds);
    s += "</td><td>";
    s += String(historyItems[i].cost, 2) + " EUR";
    s += "</td><td>";
    s += historyItems[i].confirmed ? "Bestaetigt" : "Vorlaeufig / Altbestand";
    s += "</td></tr>";
  }

  s += "</table></div></div>";
  s += htmlFoot();

  server.send(200, "text/html", s);
}

// =====================================================
// 36. CSV-EXPORT
// =====================================================

String csvSafe(String s) {
  s.replace("\"", "\"\"");
  return "\"" + s + "\"";
}

void downloadCSV() {
  String csv;

  csv += "Datum;Modell;Filament;";
  csv += "Verbrauch_g;Startgewicht_g;";
  csv += "Endgewicht_g;Dauer_s;Kosten_EUR;Endmessung_bestaetigt\n";

  for (int i = 0; i < historyCount; i++) {
    csv += csvSafe(historyItems[i].date) + ";";
    csv += csvSafe(historyItems[i].name) + ";";
    csv += csvSafe(historyItems[i].filament) + ";";
    csv += String(historyItems[i].used, 2) + ";";
    csv += String(historyItems[i].startWeight, 2) + ";";
    csv += String(historyItems[i].endWeight, 2) + ";";
    csv += String(historyItems[i].seconds) + ";";
    csv += String(historyItems[i].cost, 2) + ";";
    csv += historyItems[i].confirmed ? "ja" : "nein";
    csv += "\n";
  }

  server.sendHeader(
    "Content-Disposition",
    "attachment; filename=druckarchiv.csv"
  );

  server.send(
    200,
    "text/csv; charset=utf-8",
    csv
  );
}

