  card(12, 53, 456, 193);
  txt("Archivierte Drucke: " + String(historyCount), 24, 76, 2, WHITE);
  txt("Verbrauch: " + String(grams, 1) + " g", 24, 116, 2, GREEN);
  txt("Kosten: " + String(euros, 2) + " EUR", 24, 157, 2, WHITE);
  txt("Bestaetigte Endmessungen: " + String(good), 24, 207, 1, GRAY);
  txt("Auswertung der letzten 12 gespeicherten Drucke", 240, 250, 1, GRAY, TC_DATUM);
  button(12, 264, 456, 46, "ZURUECK ZUM ARCHIV", CARD2);
}

