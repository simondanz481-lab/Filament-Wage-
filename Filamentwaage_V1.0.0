// =====================================================
// 22. RGB-FARBAUSWAHL
// =====================================================

// =====================================================
// BAMBU-DASHBOARD V1.6
// =====================================================

void drawBambuDashboardStatic() {
  card(10, 51, 460, 117);
  card(10, 176, 460, 79);
}

void renderBambuDashboard() {
  if (!spriteReady) return;

  // Oberer Bereich: groesserer Druckstatus sowie ausgeschriebene Temperaturen.
  // Der vorhandene RGB565-Sprite ist 450 x 52 Pixel gross.
  sprite.fillSprite(CARD);

  spriteText("BAMBU A1 MINI", 4, 0, 1, GRAY);
  String stateText = bambuState;
  if (stateText.length() > 19) stateText = stateText.substring(0, 19);
  spriteText(stateText, 4, 14, stateText.length() > 14 ? 1 : 2,
             bambuConnected ? GREEN : YELLOW);

  String job = bambuJob.length() ? bambuJob : "Kein Modell";
  if (job.length() > 34) job = job.substring(0, 32) + "..";
  spriteText(job, 4, 40, 1, WHITE);

  // ASCII-Beschriftung vermeidet Probleme mit Umlauten im eingebauten TFT-Font.
  spriteText("DUESE", 244, 1, 1, GRAY);
  spriteText("DRUCKBETT", 346, 1, 1, GRAY);

  String nozzleNow = isfinite(bambuNozzleTemp)
    ? String(bambuNozzleTemp, 0) + " C" : "-- C";
  String bedNow = isfinite(bambuBedTemp)
    ? String(bambuBedTemp, 0) + " C" : "-- C";
  spriteText(nozzleNow, 244, 15, 2, WHITE);
  spriteText(bedNow, 346, 15, 2, WHITE);

  String nozzleGoal = isfinite(bambuNozzleTarget)
    ? "Soll " + String(bambuNozzleTarget, 0) + " C" : "Soll --";
  String bedGoal = isfinite(bambuBedTarget)
    ? "Soll " + String(bambuBedTarget, 0) + " C" : "Soll --";
  spriteText(nozzleGoal, 244, 39, 1, GRAY);
  spriteText(bedGoal, 346, 39, 1, GRAY);
  pushSpriteAt(15, 60);

  // Zweite Zeile: Fortschritt gut lesbar, Restzeit, Schichten, Fehler.
  sprite.fillSprite(CARD);
  spriteText(String(bambuProgress) + "%", 4, 1, 3, WHITE);

  String remainingText = bambuRemainingText(bambuRemaining);
  spriteText("RESTZEIT", 100, 0, 1, GRAY);
  // 2 h 05 min ist zweizeilig nicht noetig; bei sehr langen Werten kleinere Schrift.
  spriteText(remainingText, 100, 15, remainingText.length() <= 13 ? 2 : 1, WHITE);

  spriteText("SCHICHTEN", 273, 0, 1, GRAY);
  String layerText = (bambuLayer >= 0 ? String(bambuLayer) : "--") +
    "/" + (bambuTotalLayers >= 0 ? String(bambuTotalLayers) : "--");
  spriteText(layerText, 273, 15, layerText.length() > 10 ? 1 : 2, WHITE);

  if (bambuError != 0) {
    spriteText("Fehler " + String(bambuError, HEX), 4, 34, 1, RED);
  } else {
    spriteText(bambuConnected ? "LIVE" : "OFFLINE", 4, 34, 1,
               bambuConnected ? GREEN : YELLOW);
  }

  sprite.fillRoundRect(4, 45, 440, 5, 2, CARD2);
  int filled = (int)(440.0f * clampFloat(bambuProgress, 0, 100) / 100.0f);
  if (filled > 0) sprite.fillRect(4, 45, filled, 5, BLUE);
  pushSpriteAt(15, 112);

  // Untere Karte mit spezieller GROSSANSICHT fuer die externe Spule.
  // Die Karte reicht von y=176 bis y=255; der Fussbereich beginnt bei y=266.
  if (bambuViewMode == 1) {
    // Volle Kartenbreite nur fuer die externe Spule.
    // Zunaechst den statischen Bereich oben erneuern.
    lcd.fillRect(20, 181, 440, 13, CARD);
    txt("EXTERNE SPULE", 22, 181, 1, GRAY);

    sprite.fillSprite(CARD);
    // V1.7: ausschliesslich Farbe vom Bambu-Drucker (vt_tray/vir_slot).
    // Niemals mehr als Ersatz die Profilfarbe der Waage verwenden.
    uint16_t shownColor = externalSlot.colorKnown
      ? rgb565(externalSlot.color) : CARD2;
    sprite.fillRoundRect(7, 7, 37, 37, 5, shownColor);
    sprite.drawRoundRect(7, 7, 37, 37, 5, WHITE);
    if (!externalSlot.colorKnown)
      spriteText("?", 19, 14, 2, WHITE);

    String mat = slotMaterial(externalSlot);
    bool isProfileFallback = mat == "--";
    if (isProfileFallback) mat = active().material;
    if (mat.length() > 16) mat = mat.substring(0, 16);
    spriteText(mat, 55, 0, mat.length() > 13 ? 1 : 2, WHITE);
    if (isProfileFallback) spriteText("(Profil)", 235, 5, 1, GRAY);

    String remaining = (zeroValid && hxReady)
      ? String(restGrams, 0) + " g" : "-- g";
    spriteText(remaining, 55, 29, 2, WHITE);
    spriteText("WAAGE", 225, 38, 1, GRAY);

    spriteText("FUELLSTAND", 331, 0, 1, GRAY);
    spriteText(zeroValid && hxReady ? String(fillPercent, 0) + "%" : "--%",
               331, 15, 3, WHITE);
    sprite.fillRoundRect(328, 45, 114, 6, 3, CARD2);
    int extFilled = (int)(114.0f * clampFloat(fillPercent, 0, 100) / 100.0f);
    if (zeroValid && hxReady && extFilled > 0) {
      sprite.fillRect(328, 45, extFilled, 6, BLUE);
    }
    pushSpriteAt(15, 197);
    return;
  }

  // Bisherige AMS-Lite- und Kombinationsansichten bleiben erhalten.
  sprite.fillSprite(CARD);
  spriteText("FILAMENT: " + bambuViewName(bambuViewMode), 4, 0, 1, GRAY);

  if (bambuViewMode == 0 || bambuViewMode == 2) {
    int width = bambuViewMode == 2 ? 57 : 110;
    for (int i = 0; i < 4; i++) {
      int x = 4 + i * width;
      spriteText("A" + String(i + 1), x, 21, 1, GRAY);
      sprite.fillRoundRect(x + 16, 21, 12, 12, 2,
        amsSlots[i].colorKnown ? rgb565(amsSlots[i].color) : CARD2);
      String mat = slotMaterial(amsSlots[i]);
      int maxLen = bambuViewMode == 2 ? 7 : 12;
      if (mat.length() > maxLen) mat = mat.substring(0, maxLen);
      spriteText(mat, x, 36, 1, WHITE);
    }
  }

  if (bambuViewMode == 2) {
    int x = 245;
    spriteText("EXTERN", x, 21, 1, GRAY);
    sprite.fillRoundRect(x + 64, 21, 13, 12, 2,
      externalSlot.colorKnown ? rgb565(externalSlot.color) : CARD2);
    String mat = slotMaterial(externalSlot);
    if (mat.length() > 15) mat = mat.substring(0, 15);
    spriteText(mat, x + 85, 21, 1, WHITE);
    spriteText("Waage: " +
      (zeroValid && hxReady ? String(restGrams, 0) + " g" : "--"),
      x, 36, 1, WHITE);
  }
  pushSpriteAt(15, 186);
}

// Ein eigenes Untermenue im SYSTEM-Bereich.
