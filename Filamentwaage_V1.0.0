// =====================================================
// 27. DISPLAY AKTUALISIEREN
// =====================================================

void drawStaticPage() {
  if (currentPage == PAGE_COLOR || currentPage == PAGE_BAMBU_OPTIONS ||
      currentPage == PAGE_DISPLAY_SETTINGS || currentPage == PAGE_SYSTEM_DETAILS ||
      currentPage == PAGE_RESTART_CONFIRM || currentPage == PAGE_PRINT_ARCHIVE ||
      currentPage == PAGE_THEME_COLORS || currentPage == PAGE_NOTIFICATIONS ||
      currentPage == PAGE_STATS) {
    if (currentPage == PAGE_COLOR) drawColorMenu();
    else if (currentPage == PAGE_BAMBU_OPTIONS) drawBambuOptions();
    else if (currentPage == PAGE_DISPLAY_SETTINGS) drawDisplaySettings();
    else if (currentPage == PAGE_SYSTEM_DETAILS) drawSystemDetails();
    else if (currentPage == PAGE_PRINT_ARCHIVE) drawPrintArchive();
    else if (currentPage == PAGE_THEME_COLORS) drawThemeColors();
    else if (currentPage == PAGE_NOTIFICATIONS) drawNotificationSettings();
    else if (currentPage == PAGE_STATS) drawStats();
    else drawRestartConfirm();
    pageDirty = false;
    return;
  }

  lcd.fillScreen(BG);

  drawHeader();
  drawFooter();

  switch (currentPage) {
    case PAGE_SCALE:
      drawScaleStatic();
      break;

    case PAGE_PROFILE:
      drawProfileStatic();
      break;

    case PAGE_PRINT:
      drawPrintStatic();
      break;

    case PAGE_BAMBU:
      drawBambuDashboardStatic();
      break;

    case PAGE_SYSTEM:
      drawSystemStatic();
      break;

    default:
      break;
  }

  previousSignature = "";
  pageDirty = false;
}

String dynamicSignature() {
  String s =
    String((int)currentPage) + "|";

  switch (currentPage) {
    case PAGE_SCALE:
      s +=
        String(weightGrams, 1) + "|" +
        String(restGrams, 1) + "|" +
        String(fillPercent, 0) + "|" +
        String(stable) + "|" +
        String(activeProfile) + "|" +
        String(hxReady) + "|" + String(zeroValid);
      break;

    case PAGE_PROFILE:
      s +=
        String(activeProfile) + "|" +
        colorHex(active().rgb);
      break;

    case PAGE_PRINT:
      s +=
        bambuState + "|" +
        bambuJob + "|" +
        String(bambuProgress) + "|" +
        String(printUsed, 1) + "|" +
        String(printActive) + "|" + String(printEndPending) + "|" +
        String(hybridDisturbed) + "|" + String(lastPrintConfirmed);
      break;

    case PAGE_BAMBU:
      s += bambuState + "|" + bambuJob + "|" +
        String(bambuProgress) + "|" + String(bambuRemaining) + "|" +
        String(bambuNozzleTemp, 0) + "|" + String(bambuNozzleTarget, 0) + "|" +
        String(bambuBedTemp, 0) + "|" + String(bambuBedTarget, 0) + "|" +
        String(bambuLayer) + "|" + String(bambuTotalLayers) + "|" +
        String(bambuError) + "|" + String(bambuViewMode) + "|" +
        String(restGrams, 0);
      for (int i = 0; i < 4; i++) {
        s += "|" + amsSlots[i].material + ":" + colorHex(amsSlots[i].color);
      }
      s += "|" + externalSlot.material + ":" + colorHex(externalSlot.color) +
           ":" + String(externalSlot.colorKnown);
      break;

    case PAGE_SYSTEM:
      s +=
        String(hxReady) + "|" +
        String(zeroOffset) + "|" +
        currentIP();
      break;

    case PAGE_COLOR:
      s += colorHex(temporaryColor);
      break;

    case PAGE_BAMBU_OPTIONS:
      s += String(pendingBambuViewMode);
      break;
    case PAGE_DISPLAY_SETTINGS:
    case PAGE_SYSTEM_DETAILS:
    case PAGE_RESTART_CONFIRM:
    case PAGE_PRINT_ARCHIVE:
    case PAGE_THEME_COLORS:
    case PAGE_NOTIFICATIONS:
    case PAGE_STATS:
      break;
  }

  return s;
}

void updateDisplay() {
  // Meldung zeitlich abgelaufen oder durch Einstellungen deaktiviert:
  // genau einmal die darunterliegende Seite vollstaendig wiederherstellen.
  if (displayNoticeUntil && !noticeVisible()) {
    displayNoticeUntil = 0;
    displayNotice = "";
    noticePopupDrawn = false;
    pageDirty = true;
    // Nach dem Loeschen in derselben LCD-Runde dynamische Werte erneuern.
    lastDraw = millis() - 300UL;
  }

  // Eine sichtbare Meldung hat Vorrang vor allen Hintergrund-Updates.
  // Zeichnen exakt einmal pro Meldung. HX711, WLAN, MQTT und Webserver
  // laufen weiter, lediglich das LCD-Rendering der Hauptseite pausiert.
  // Anstehende pageDirty-Updates werden nach Ablauf/Touch nachgeholt.
  if (noticeVisible()) {
    if (!noticePopupDrawn) {
      drawNoticePopup();
      noticePopupDrawn = true;
    }
    return;
  }

  bool repainted = false;
  if (pageDirty) {
    drawStaticPage();
    repainted = true;
  }

  const bool submenu =
      currentPage == PAGE_COLOR || currentPage == PAGE_BAMBU_OPTIONS ||
      currentPage == PAGE_DISPLAY_SETTINGS || currentPage == PAGE_SYSTEM_DETAILS ||
      currentPage == PAGE_RESTART_CONFIRM || currentPage == PAGE_PRINT_ARCHIVE ||
      currentPage == PAGE_THEME_COLORS || currentPage == PAGE_NOTIFICATIONS ||
      currentPage == PAGE_STATS;

  // Die Sonderseiten bleiben wie in V1.7 statisch. Auf Hauptseiten
  // wird weiterhin nur bei veraenderter Signatur dynamisch gerendert.
  if (!submenu && millis() - lastDraw >= 300) {
    lastDraw = millis();
    String signature = dynamicSignature();
    if (signature != previousSignature) {
      previousSignature = signature;
      switch (currentPage) {
        case PAGE_SCALE:   renderScaleDynamic(); break;
        case PAGE_PROFILE: renderProfileDynamic(); break;
        case PAGE_PRINT:   renderPrintDynamic(); break;
        case PAGE_BAMBU:   renderBambuDashboard(); break;
        case PAGE_SYSTEM:  break;
        default: break;
      }
      repainted = true;
    }
  }

  // Kein Popup-Overdraw im normalen 300-ms-Renderzyklus.
}

// Popup durch Touch schliessen: Seiteninhalt wird im naechsten
// updateDisplay() genau einmal wiederhergestellt.
void closeNoticePopup() {
  displayNoticeUntil = 0;
  displayNotice = "";
  noticePopupDrawn = false;
  pageDirty = true;
  lastDraw = millis() - 300UL;
  Serial.println(F("[MELDUNG] Per Touch geschlossen"));
}

// =====================================================
// 28. TOUCH-BEDIENUNG
// =====================================================

bool hit(
  int x,
  int y,
  int bx,
  int by,
  int w,
  int h
) {
  return
    x >= bx &&
    x < bx + w &&
    y >= by &&
    y < by + h;
}

void updateTouch() {
  uint16_t x, y;

  bool pressed =
    lcd.getTouch(&x, &y);

  if (!pressed) {
    touchDown = false;
    return;
  }

  if (touchDown) {
    return;
  }

  touchDown = true;
  lastDisplayInteraction = millis();
  if (!displayAwake) {
    displayAwake = true;
    setDisplayBacklight();
    pageDirty = true;
    // Falls eine Meldung sichtbar sein sollte, schliesst der erste
    // Touch sie gleichzeitig. Sonst weckt er nur das Display.
    if (noticeVisible()) closeNoticePopup();
    return;
  }

  // Popup-Touch VOR dem normalen 180-ms-Debounce pruefen: selbst sehr
  // schnelle Tippbewegungen schliessen die Einblendung sicher.
  // Jeder Touchpunkt gilt als Schliessen, auch das X oben rechts.
  // Wichtig: nicht zur normalen Menue-Touchlogik durchfallen lassen.
  if (noticeVisible()) {
    closeNoticePopup();
    return;
  }

  if (millis() - lastTouch < 180) {
    return;
  }

  lastTouch = millis();

  Serial.printf(
    "Touch X:%u Y:%u\n",
    x, y
  );

  // RGB-UNTERMENUE
  if (currentPage == PAGE_COLOR) {
    for (int i = 0; i < PALETTE_COUNT; i++) {
      int col = i % 6;
      int row = i / 6;

      int bx = 17 + col * 77;
      int by = 76 + row * 66;

      if (hit(x, y, bx, by, 61, 48)) {
        temporaryColor = PALETTE[i];
        pageDirty = true;
        return;
      }
    }

    if (hit(x, y, 16, 260, 215, 49)) {
      cancelColorMenu();
      return;
    }

    if (hit(x, y, 249, 260, 215, 49)) {
      saveSelectedColor();
      return;
    }

    return;
  }

  // BAMBU-ANSICHT: Auswahl wird erst nach SPEICHERN aktiv.
  if (currentPage == PAGE_BAMBU_OPTIONS) {
    if (hit(x, y, 18, 76, 444, 42)) pendingBambuViewMode = 0;
    else if (hit(x, y, 18, 128, 444, 42)) pendingBambuViewMode = 1;
    else if (hit(x, y, 18, 180, 444, 42)) pendingBambuViewMode = 2;
    else if (hit(x, y, 18, 251, 211, 52)) {
      currentPage = PAGE_SYSTEM;
      pageDirty = true;
      return;
    } else if (hit(x, y, 251, 251, 211, 52)) {
      saveBambuOptions();
      return;
    }
    pageDirty = true;
    return;
  }

  // DISPLAY-FARBEN: 12 Vorlagen oder sechsstellige HEX-Touch-Tastatur.
  if (currentPage == PAGE_THEME_COLORS) {
    if (hit(x, y, 12, 38, 220, 37)) {
      themeEditTarget = 0;
      themeHexDigits = "";
    } else if (hit(x, y, 248, 38, 220, 37)) {
      themeEditTarget = 1;
      themeHexDigits = "";
    } else if (hit(x, y, 12, 130, 220, 29)) {
      themeColorInputMode = 0;
      themeHexDigits = "";
    } else if (hit(x, y, 248, 130, 220, 29)) {
      themeColorInputMode = 1;
      themeHexDigits = "";
    } else if (hit(x, y, 12, 281, 140, 32)) {
      currentPage = PAGE_DISPLAY_SETTINGS;
      pageDirty = true;
      return;
    } else if (hit(x, y, 161, 281, 140, 32)) {
      pendingCustomColors = false;
      updatePendingColorDefaults();
      currentPage = PAGE_DISPLAY_SETTINGS;
      pageDirty = true;
      return;
    } else if (hit(x, y, 310, 281, 158, 32)) {
      if (readableColors(editBgRgb, editTextRgb)) {
        pendingBgRgb = editBgRgb;
        pendingTextRgb = editTextRgb;
        pendingCustomColors = true;
        currentPage = PAGE_DISPLAY_SETTINGS;
      } else {
        colorContrastWarning = true;
      }
      pageDirty = true;
      return;
    } else if (themeColorInputMode == 0) {
      for (int i = 0; i < PALETTE_COUNT; i++) {
        int px = 17 + (i % 6) * 77;
        int py = 165 + (i / 6) * 40;
        if (hit(x, y, px, py, 61, 33)) {
          if (themeEditTarget == 0) editBgRgb = PALETTE[i];
          else editTextRgb = PALETTE[i];
          themeHexDigits = "";
          break;
        }
      }
    } else {
      if (hit(x, y, 346, 239, 118, 24)) {
        themeHexDigits = "";
      } else {
        const char* keys = "0123456789ABCDEF";
        for (int i = 0; i < 16; i++) {
          int kx = 17 + (i % 8) * 57;
          int ky = 165 + (i / 8) * 40;
          if (hit(x, y, kx, ky, 51, 34)) {
            if (themeHexDigits.length() < 6) {
              themeHexDigits += keys[i];
              if (themeHexDigits.length() == 6) {
                uint32_t value = strtoul(themeHexDigits.c_str(), nullptr, 16);
                if (themeEditTarget == 0) editBgRgb = value;
                else editTextRgb = value;
              }
            }
            break;
          }
        }
      }
    }
    pageDirty = true;
    return;
  }

  // Ereignismeldungen: zwei Kanaele, je Typ separat schaltbar.
  if (currentPage == PAGE_NOTIFICATIONS) {
    if (hit(x, y, 12, 260, 128, 49)) {
      currentPage = PAGE_DISPLAY_SETTINGS;
    } else if (hit(x, y, 152, 260, 145, 49)) {
      noticePage ^= 1;
    } else if (hit(x, y, 310, 260, 158, 49)) {
      noticeDisplayMask = pendingNoticeDisplayMask;
      noticeWebMask = pendingNoticeWebMask;
      saveV18Settings();
      currentPage = PAGE_DISPLAY_SETTINGS;
      logEvent("V1.0.0 Meldungseinstellungen gespeichert (LCD/Web)");
    } else {
      for (uint8_t row = 0; row < 4; ++row) {
        uint8_t i = noticePage * 4 + row;
        if (i >= N_COUNT) break;
        int yy = 77 + row * 42;
        if (hit(x, y, 302, yy, 72, 33))
          pendingNoticeDisplayMask ^= (1U << i);
        if (hit(x, y, 389, yy, 72, 33))
          pendingNoticeWebMask ^= (1U << i);
      }
    }
    pageDirty = true;
    return;
  }
  if (currentPage == PAGE_STATS) {
    if (hit(x, y, 12, 264, 456, 46)) currentPage = PAGE_PRINT_ARCHIVE;
    pageDirty = true;
    return;
  }

  // ANZEIGE-EINSTELLUNGEN: Aenderungen erst beim Speichern.
  if (currentPage == PAGE_DISPLAY_SETTINGS) {
    if (hit(x, y, 270, 49, 54, 34))
      pendingBrightness = (uint8_t)max(10, (int)pendingBrightness - 5);
    else if (hit(x, y, 404, 49, 54, 34))
      pendingBrightness = (uint8_t)min(100, (int)pendingBrightness + 5);
    else if (hit(x, y, 270, 102, 54, 36))
      pendingTimeoutChoice = pendingTimeoutChoice == 0 ? 4 : pendingTimeoutChoice - 1;
    else if (hit(x, y, 404, 102, 54, 36))
      pendingTimeoutChoice = (pendingTimeoutChoice + 1) % 5;
    else if (hit(x, y, 331, 143, 125, 32)) {
      pendingDarkMode = !pendingDarkMode;
      updatePendingColorDefaults();
    } else if (hit(x, y, 265, 178, 91, 32))
      pendingNotifications = !pendingNotifications;
    else if (hit(x, y, 365, 178, 91, 32)) {
      pendingNoticeDisplayMask = noticeDisplayMask;
      pendingNoticeWebMask = noticeWebMask;
      noticePage = 0;
      currentPage = PAGE_NOTIFICATIONS;
      pageDirty = true;
      return;
    } else if (hit(x, y, 268, 214, 188, 34)) {
      openThemeColors();
      return;
    } else if (hit(x, y, 12, 258, 213, 52)) {
      currentPage = PAGE_SYSTEM;
      pageDirty = true;
      return;
    } else if (hit(x, y, 244, 258, 224, 52)) {
      saveDisplayPrefs();
      return;
    }
    pageDirty = true;
    return;
  }

  if (currentPage == PAGE_SYSTEM_DETAILS) {
    if (hit(x, y, 12, 258, 456, 52)) {
      currentPage = PAGE_SYSTEM;
    } else if (systemDetailsType == 3 && hit(x, y, 314, 198, 140, 39)) {
      tareScale();
    }
    pageDirty = true;
    return;
  }

  if (currentPage == PAGE_RESTART_CONFIRM) {
    if (hit(x, y, 18, 212, 211, 67)) {
      currentPage = PAGE_SYSTEM;
      pageDirty = true;
    } else if (hit(x, y, 251, 212, 211, 67)) {
      ESP.restart();
    }
    return;
  }

  // DRUCKARCHIV aus dem DRUCK-Menue
  if (currentPage == PAGE_PRINT_ARCHIVE) {
    if (hit(x, y, 351, 8, 117, 35)) {
      currentPage = PAGE_STATS;
    } else if (hit(x, y, 12, 262, 128, 49)) {
      currentPage = PAGE_PRINT;
    } else if (hit(x, y, 164, 262, 144, 49)) {
      printArchiveOffset = max(0, printArchiveOffset - 4);
    } else if (hit(x, y, 331, 262, 137, 49)) {
      if (printArchiveOffset + 4 < historyCount) printArchiveOffset += 4;
    }
    pageDirty = true;
    return;
  }

  // HAUPTNAVIGATION: 5 Menuepunkte zu je 96 px.
  if (y >= 266) {
    int selected = x / 96;
    if (selected >= 0 && selected <= 4) {
      currentPage = (Page)selected;
      pageDirty = true;
    }
    return;
  }

  // PROFILE - kein weiterer SYSTEM-Knopf (SYSTEM ist unten im Hauptmenue).
  if (currentPage == PAGE_PROFILE) {
    if (hit(x, y, 10, 193, 140, 60)) {
      changeProfile(-1);
    } else if (hit(x, y, 160, 193, 140, 60)) {
      changeProfile(1);
    } else if (hit(x, y, 310, 193, 160, 60)) {
      openColorMenu();
    }
  }

  // DRUCK
  if (currentPage == PAGE_PRINT) {
    if (hit(x, y, 350, 55, 110, 23)) {
      printArchiveOffset = 0;
      currentPage = PAGE_PRINT_ARCHIVE;
      pageDirty = true;
      return;
    }
    if (hit(x, y, 259, 182, 96, 62)) {
      startPrint(false);
    } else if (hit(x, y, 365, 182, 96, 62)) {
      stopPrint();
    }
  }

  // SYSTEM: Acht Karten wie in der Vorschau.
  if (currentPage == PAGE_SYSTEM) {
    for (int i = 0; i < 8; i++) {
      int col = i % 4, row = i / 4;
      if (!hit(x, y, 10 + col * 116, 60 + row * 95, 106, 82)) continue;
      if (i == 0) openDisplaySettings();
      else if (i == 1) { currentPage = PAGE_BAMBU; pageDirty = true; }
      else if (i == 2) openBambuOptions();
      else if (i == 7) { currentPage = PAGE_RESTART_CONFIRM; pageDirty = true; }
      else {
        systemDetailsType = (uint8_t)(i - 3);
        currentPage = PAGE_SYSTEM_DETAILS;
        pageDirty = true;
      }
      return;
    }
  }
}

// =====================================================
// 29. HTML-GRUNDGERUEST
// =====================================================

String htmlHead(String title) {
  String s;
  s.reserve(5500);

  s += "<!DOCTYPE html>";
  s += "<html lang='de'><head>";
  s += "<meta charset='utf-8'>";
  s += "<meta name='viewport' ";
  s += "content='width=device-width,initial-scale=1'>";
  s += "<title>";
  s += escapeHTML(title);
  s += "</title>";

  s += R"HTML(
<style>
:root{
 --bg:#101820;
 --panel:#20303c;
 --field:#111c25;
 --line:#384b59;
 --text:#f3f7fb;
 --muted:#aabac6;
 --blue:#2684c7;
 --green:#38d9a9;
}
*{box-sizing:border-box}
body{
 margin:0;
 padding:18px;
 background:var(--bg);
 color:var(--text);
 font-family:Arial,sans-serif;
}
main{
 max-width:930px;
 margin:auto;
}
h1{font-size:26px}
h2{font-size:19px;margin-top:0}
h3{font-size:16px}
nav{
 display:flex;
 flex-wrap:wrap;
 gap:6px;
 margin-bottom:15px;
}
a{color:#74c9ff}
.card{
 background:var(--panel);
 border-radius:14px;
 padding:18px;
 margin:12px 0;
}
.grid{
 display:grid;
 grid-template-columns:repeat(
  auto-fit,minmax(210px,1fr)
 );
 gap:12px;
}
.value{
 font-size:35px;
 font-weight:bold;
 color:var(--green);
}
.muted{color:var(--muted)}
.small{font-size:13px}
input,select{
 width:100%;
 padding:12px;
 margin:7px 0 13px;
 border:1px solid var(--line);
 border-radius:8px;
 background:var(--field);
 color:white;
}
input[type=color]{
 height:55px;
 padding:4px;
 cursor:pointer;
}
button,.link{
 display:inline-block;
 border:0;
 border-radius:8px;
 padding:11px 15px;
 margin:4px 3px 4px 0;
 background:var(--blue);
 color:white;
 text-decoration:none;
 cursor:pointer;
}
.ok{background:#247e58}
.danger{background:#ac404b}
.progress{
 width:100%;
 height:14px;
 background:#12212b;
 border-radius:9px;
 overflow:hidden;
}
.fill{
 height:100%;
 width:0%;
 background:var(--green);
}
table{
 width:100%;
 border-collapse:collapse;
}
th,td{
 padding:10px;
 text-align:left;
 border-bottom:1px solid var(--line);
}
.scroll{overflow-x:auto}
pre{
 white-space:pre-wrap;
 overflow-wrap:anywhere;
 font-size:12px;
}
</style>
</head><body><main>
)HTML";

  s += "<h1>Filamentwaage V1.0.0</h1>";
  s += "<nav>";

  const char* paths[] = {
    "/",
    "/profiles",
    "/printer",
    "/history",
    "/console",
    "/notifications",
    "/settings"
  };

  const char* labels[] = {
    "Waage",
    "Filamentprofile",
    "Bambu Lab",
    "Druckarchiv",
    "Konsole",
    "Meldungen",
    "System"
  };

  for (int i = 0; i < 7; i++) {
    s += "<a class='link' href='";
    s += paths[i];
    s += "'>";
    s += labels[i];
    s += "</a>";
  }

  s += "</nav>";
  s += "<div id='fwToast' role='status' style='display:none;padding:12px;background:#284653;";
  s += "border-radius:9px;margin:10px 0'></div>";
  return s;
}

String htmlFoot() {
  return R"HTML(<script>
  (function(){let seq=null;let hide=null;
    async function check(){try{
      const r=await fetch('/api/notices',{cache:'no-store'});
      if(!r.ok)return;
      const d=await r.json();
      if(seq!==null && d.sequence>seq && d.events.length){
        const e=d.events[0];
        const el=document.getElementById('fwToast');
        el.textContent=e.date+' | '+e.message;
        el.style.display='block';
        clearTimeout(hide);hide=setTimeout(()=>el.style.display='none',6500);
      }
      seq=d.sequence;
    }catch(err){}}
    check();setInterval(check,4000);
  })();
  </script></main></body></html>)HTML";
}

// =====================================================
// 30. WEBSEITE: WAAGE
// =====================================================

void pageHome() {
  String s = htmlHead("Waage");

  s += "<div class='card'><h2>Zusaetzlicher Gewichtsabzug</h2>";
  s += "<p class='muted small'>Wird vom angezeigten Gesamtgewicht abgezogen, "
       "zusaetzlich zum Spulenleergewicht des aktiven Profils. "
       "Messung, Tara und Druckverbrauch bleiben unveraendert.</p>";
  s += "<form method='post' action='/weight/deduction'>";
  s += "<label>Abzug in Gramm (0 = kein Abzug)</label>";
  s += "<input name='deduct' type='number' min='0' max='5000' "
       "step='0.1' required value='" + String(manualDeductionGrams, 1) + "'>";
  s += "<button class='ok'>Gewichtsabzug speichern</button></form>";
  s += "<p class='muted small'>Wert bleibt nach einem Neustart gespeichert.</p></div>";

  s += R"HTML(
<div class="grid">
 <div class="card">
  <h2>Gesamtgewicht</h2>
  <div class="value" id="weight">-- g</div>
  <p class="muted" id="stable">Messung...</p>
 </div>

 <div class="card">
  <h2>Restfilament</h2>
  <div class="value" id="rest">-- g</div>
  <p id="profile">--</p>
 </div>

 <div class="card">
  <h2>Fuellstand</h2>
  <div class="value" id="percent">-- %</div>
  <div class="progress">
   <div class="fill" id="fill"></div>
  </div>
 </div>
</div>

<div class="card">
 <h2>Bambu Lab</h2>
 <p>Status: <b id="bambu">--</b></p>
 <p>Modell: <b id="job">--</b></p>
 <p>Fortschritt:
 <b id="progress">--</b>%</p>
 <p>Restzeit:
 <b id="remaining">--</b></p>
</div>

<div class="card">
 <h2>Reicht das Filament?</h2>
 <p>Erwarteter Verbrauch:</p>

 <form method="post" action="/estimate">
  <input name="grams" type="number"
   min="0" max="5000" step="0.1"
   placeholder="z.B. 120">
  <button>Pruefen</button>
 </form>

 <p>Ergebnis: <b id="enough">--</b></p>
</div>

<div class="card">
 <h2>Druckverbrauch</h2>
 <p>Messung: <b id="printing">--</b></p>
 <p>Verbrauch: <b id="used">-- g</b></p>
 <p>Hybridmessung: <b id="hybrid">--</b></p>
 <p>Filamentkosten: <b id="cost">-- EUR</b></p>

 <form method="post" action="/print/start">
  <button class="ok">Druck starten</button>
 </form>

 <form method="post" action="/print/stop">
  <button class="danger">Druck stoppen</button>
 </form>
</div>

<script>
async function refresh(){
 try{
  const r=await fetch('/api',{cache:'no-store'});

  if(!r.ok)return;

  const d=await r.json();

  const set=(id,value)=>{
   document.getElementById(id).textContent=value;
  };

  set('weight',d.weight.toFixed(1)+' g');
  set('rest',d.rest.toFixed(1)+' g');
  set('percent',d.percent.toFixed(0)+' %');

  set('profile',d.profile);
  set('stable',d.stable?'Stabil':'Messung laeuft');

  document.getElementById('fill')
   .style.width=d.percent+'%';

  document.getElementById('fill')
   .style.background=d.rgb;

  set('bambu',d.bambu);
  set('job',d.job||'-');
  set('progress',d.progress);
  set('remaining',d.remaining_text);

  set('enough',d.enough);

  set('printing',d.printing?'Aktiv':'Inaktiv');
  set('used',d.used.toFixed(1)+' g'+(d.hybrid_provisional?' (vorlaeufig)':''));
  set('hybrid',d.hybrid_status);
  set('cost',d.cost_eur.toFixed(2)+' EUR');

 }catch(e){}
}
refresh();
setInterval(refresh,1200);
</script>
)HTML";

  s += htmlFoot();

  server.send(200, "text/html", s);
}

// =====================================================
// 31. WEBSEITE: FILAMENTPROFILE
// =====================================================

void pageProfiles() {
  String s = htmlHead("Filamentprofile");

  s += "<div class='card'>";
  s += "<h2>Gespeicherte Profile</h2>";

  for (int i = 0; i < profileCount; i++) {
    s += "<div style='padding:10px 0'>";

    s += "<span style='display:inline-block;";
    s += "width:19px;height:19px;";
    s += "border-radius:5px;";
    s += "vertical-align:middle;";
    s += "background:";
    s += colorHex(profiles[i].rgb);
    s += "'></span> ";

    s += "<b>";
    s += escapeHTML(profiles[i].name);
    s += " ";
    s += escapeHTML(profiles[i].material);
    s += "</b>";

    if (i == activeProfile) {
      s += " (aktiv)";
    }

    s += "<p class='muted small'>";
    s += "Leergewicht: ";
    s += String(profiles[i].emptyWeight, 1);
    s += " g | Voll: ";
    s += String(profiles[i].fullWeight, 1);
    s += " g | Preis: ";
    s += String(profiles[i].priceKg, 2);
    s += " EUR/kg | RGB: ";
    s += colorHex(profiles[i].rgb);
    s += "</p>";

    s += "<a class='link' href='/profiles?edit=";
    s += String(i);
    s += "'>Bearbeiten</a>";

    s += "<form method='post' ";
    s += "action='/profile/select' ";
    s += "style='display:inline'>";

    s += "<input type='hidden' name='id' value='";
    s += String(i);
    s += "'>";

    s += "<button>Aktivieren</button>";
    s += "</form>";

    s += "</div><hr>";
  }

  s += "</div>";

  int id = server.hasArg("edit")
    ? server.arg("edit").toInt()
    : -1;

  bool editing =
    id >= 0 && id < profileCount;

  s += "<div class='card'>";

  s += editing
    ? "<h2>Profil bearbeiten</h2>"
    : "<h2>Neues Profil anlegen</h2>";

  s += "<form method='post' action='/profile/save'>";

  s += "<input type='hidden' name='id' value='";
  s += String(editing ? id : -1);
  s += "'>";

  s += "<label>Hersteller / Name</label>";
  s += "<input name='name' maxlength='32' required value='";

  if (editing) {
    s += escapeHTML(profiles[id].name);
  }

  s += "'>";

  s += "<label>Material</label>";
  s += "<select name='material'>";

  const char* materials[] = {
    "PLA", "PETG", "ABS", "ASA",
    "TPU", "PA", "PC", "OTHER"
  };

  for (int i = 0; i < 8; i++) {
    String mat = materials[i];

    s += "<option value='" + mat + "'";

    if (
      editing &&
      profiles[id].material == mat
    ) {
      s += " selected";
    }

    s += ">" + mat + "</option>";
  }

  s += "</select>";

  s += "<label>Leergewicht der Spule (g)</label>";

  s += "<input type='number' name='empty' ";
  s += "min='0' max='5000' step='0.1' required value='";

  s += String(
    editing
      ? profiles[id].emptyWeight
      : 170.0f,
    1
  );

  s += "'>";

  s += "<label>Volle Filamentmenge (g)</label>";

  s += "<input type='number' name='full' ";
  s += "min='1' max='5000' step='0.1' required value='";

  s += String(
    editing
      ? profiles[id].fullWeight
      : 1000.0f,
    1
  );

  s += "'>";

  s += "<label>Filamentpreis pro kg (EUR)</label>";
  s += "<input type='number' name='price' min='0' max='1000' step='0.01' required value='";
  s += String(editing ? profiles[id].priceKg : 0.0f, 2);
  s += "'>";

  s += "<h3>RGB-Farbe</h3>";
  s += "<label>Farbwaehler</label>";

  s += "<input type='color' id='picker' name='color' value='";

  s += colorHex(
    editing
      ? profiles[id].rgb
      : 0x21C5FF
  );

  s += "'>";

  s += "<label>RGB-Hexwert</label>";
  s += "<input id='hex' maxlength='7' value='";

  s += colorHex(
    editing
      ? profiles[id].rgb
      : 0x21C5FF
  );

  s += "'>";

  s += R"HTML(
<script>
const picker=document.getElementById('picker');
const hex=document.getElementById('hex');

picker.addEventListener('input',()=>{
 hex.value=picker.value.toUpperCase();
});

hex.addEventListener('change',()=>{
 if(/^#[0-9A-Fa-f]{6}$/.test(hex.value)){
  picker.value=hex.value;
 }
});
</script>
)HTML";

  s += "<button class='ok'>";
  s += "Profil speichern";
  s += "</button>";
  s += "</form>";

  if (editing && profileCount > 1) {
    s += "<form method='post' action='/profile/delete'>";

    s += "<input type='hidden' name='id' value='";
    s += String(id);
    s += "'>";

    s += "<button class='danger'>";
    s += "Profil loeschen";
    s += "</button>";
    s += "</form>";
  }

  s += "</div>";
  s += htmlFoot();

  server.send(200, "text/html", s);
}

// =====================================================
// 32. WEB-PROFILE SPEICHERN
// =====================================================

void saveProfileWeb() {
  float price = server.arg("price").toFloat();
  if (!server.hasArg("price") || !isfinite(price) || price < 0 || price > 1000) {
    server.send(400, "text/plain", "Ungueltiger Filamentpreis");
    return;
  }
  int id = server.arg("id").toInt();

  if (id < 0 || id >= profileCount) {
    if (profileCount >= MAX_PROFILES) {
      server.send(
        400,
        "text/plain",
        "Maximal 8 Profile"
      );
      return;
    }

    id = profileCount++;
  }

  String name = server.arg("name");
  name.trim();

  if (name.isEmpty()) {
    name = "Filament";
  }

  profiles[id].name =
    name.substring(0, 32);

  profiles[id].material =
    server.arg("material");

  profiles[id].emptyWeight = clampFloat(
    server.arg("empty").toFloat(),
    0,
    5000
  );

  profiles[id].fullWeight = clampFloat(
    server.arg("full").toFloat(),
    1,
    5000
  );

  profiles[id].rgb =
    readHexColor(server.arg("color"));
  profiles[id].priceKg = price;

  saveProfiles();
  pageDirty = true;

  logEvent(
    "Profil gespeichert: " +
    profiles[id].name
  );

  redirect("/profiles");
}

void selectProfileWeb() {
  int id = server.arg("id").toInt();

  if (id >= 0 && id < profileCount) {
    activeProfile = id;

    prefs.putUInt(
      "pa",
      activeProfile
    );

    pageDirty = true;
  }

  redirect("/profiles");
}

void deleteProfileWeb() {
  int id = server.arg("id").toInt();

  if (
    id < 0 ||
    id >= profileCount ||
    profileCount <= 1
  ) {
    server.send(
      400,
      "text/plain",
      "Ungueltig"
    );
    return;
  }

  for (int i = id; i < profileCount - 1; i++) {
    profiles[i] = profiles[i + 1];
  }

  profileCount--;

  if (activeProfile >= profileCount) {
    activeProfile = profileCount - 1;
  }

  saveProfiles();
  pageDirty = true;

  redirect("/profiles");
}

