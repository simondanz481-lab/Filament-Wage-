  s += escapeHTML(String(WIFI_SSID));
  s += "</p>";

  s += "<p>IP-Adresse: ";
  s += currentIP();
  s += "</p>";

  s += "</div>";

  s += "<div class='card'>";
  s += "<h2>Bambu-Anzeige</h2>";
  s += "<p>Welche Filamentquellen im BAMBU-Menue zeigen?</p>";
  s += "<form method='post' action='/bambu/view'>";
  s += "<select name='mode'>";
  for (int i = 0; i < 3; i++) {
    s += "<option value='" + String(i) + "'";
    if (bambuViewMode == i) s += " selected";
    s += ">" + bambuViewName(i) + "</option>";
  }
  s += "</select><button class='ok'>Anzeigemodus speichern</button>";
  s += "</form></div>";

  s += "<div class='card'><h2>Anzeige-Einstellungen</h2>";
  s += "<form method='post' action='/display/save'>";
  s += "<label>Helligkeit (10 bis 100 %)</label>";
  s += "<input name='brightness' type='number' min='10' max='100' value='";
  s += String(displayBrightness);
  s += "'>";
  s += "<label>Display-Timeout</label><select name='timeout'>";
  for (int i = 0; i < 5; i++) {
    s += "<option value='" + String(i) + "'";
    if (displayTimeoutChoice == i) s += " selected";
    s += ">" + timeoutLabel(i) + "</option>";
  }
  s += "</select>";
  s += "<label><input name='dark' type='checkbox' value='1' style='width:auto'";
  if (displayDarkMode) s += " checked";
  s += "> Dunkelmodus</label>";
  s += "<label><input name='notice' type='checkbox' value='1' style='width:auto'";
  if (displayNotifications) s += " checked";
  s += "> Statusbenachrichtigungen</label>";
  s += "<h3>Eigene Hintergrund- und Schriftfarbe</h3>";
  s += "<label><input type='checkbox' name='custom' id='customCol' value='1' style='width:auto'";
  if (customColorsEnabled) s += " checked";
  s += "> Eigene Farben aktivieren (sonst Hell-/Dunkelmodus)</label>";
  s += "<label>Hintergrundfarbe</label><input type='color' name='bgcolor' id='bgcolor' value='";
  s += colorHex(customColorsEnabled ? customBgRgb : defaultBackgroundRgb(displayDarkMode));
  s += "'>";
  s += "<label>Hintergrund HEX (#RRGGBB)</label><input id='bghex' maxlength='7' value='";
  s += colorHex(customColorsEnabled ? customBgRgb : defaultBackgroundRgb(displayDarkMode));
  s += "'>";
  s += "<label>Schriftfarbe</label><input type='color' name='textcolor' id='textcolor' value='";
  s += colorHex(customColorsEnabled ? customTextRgb : defaultTextRgb(displayDarkMode));
  s += "'>";
  s += "<label>Schrift HEX (#RRGGBB)</label><input id='texthex' maxlength='7' value='";
  s += colorHex(customColorsEnabled ? customTextRgb : defaultTextRgb(displayDarkMode));
  s += "'>";
  s += R"HTML(
  <h3>12 voreingestellte Farben</h3>
  <label>Farbe anwenden auf</label>
  <select id='themeTarget'><option value='bg'>Hintergrund</option>
  <option value='text'>Schriftfarbe</option></select>
  <div id='themePalette' style='display:grid;grid-template-columns:repeat(6,1fr);gap:7px'></div>
  <p class='small muted'>Eigene HEX-Codes sind moeglich. Bei zu geringem Kontrast wird nicht gespeichert.</p>
  <script>
  const palette=['#FF3B30','#FF9500','#FFCC00','#30D158',
    '#00C7BE','#0A84FF','#5E5CE6','#BF5AF2',
    '#FFFFFF','#AAAAAA','#222222','#FF69B4'];
  const customCheck=document.getElementById('customCol');
  const colorFields=[['bgcolor','bghex'],['textcolor','texthex']];
  for(const [pickerId,hexId] of colorFields){
    const picker=document.getElementById(pickerId);
    const hex=document.getElementById(hexId);
    picker.addEventListener('input',()=>{
      hex.value=picker.value.toUpperCase();
      customCheck.checked=true;
    });
    hex.addEventListener('input',()=>{
      const val=hex.value.trim().toUpperCase();
      if(/^#[0-9A-F]{6}$/.test(val)){
        picker.value=val;
        customCheck.checked=true;
      }
    });
    hex.addEventListener('change',()=>{
      if(!/^#[0-9A-Fa-f]{6}$/.test(hex.value.trim())){
        hex.value=picker.value.toUpperCase();
      }
    });
  }
  const pbox=document.getElementById('themePalette');
  for(const hex of palette){
    const btn=document.createElement('button');
    btn.type='button';btn.title=hex;
    btn.style='background:'+hex+';height:38px;border:1px solid #9ca3af;padding:0';
    btn.addEventListener('click',()=>{
      const target=document.getElementById('themeTarget').value;
      document.getElementById(target==='bg'?'bgcolor':'textcolor').value=hex;
      document.getElementById(target==='bg'?'bghex':'texthex').value=hex;
      customCheck.checked=true;
    });
    pbox.appendChild(btn);
  }
  </script>)HTML";
  s += "<button class='ok'>Display-Einstellungen speichern</button></form></div>";

  s += "<div class='card'><h2>Hybridmessung und Filamentwarnung</h2>";
  s += "<p>Vorlaeufige Live-Werte, Stoerungserkennung und stabile Endmessung sind aktiv.</p>";
  s += "<form method='post' action='/warning/save'>";
  s += "<label>Warnschwelle Restfilament (g, 0 = aus)</label>";
  s += "<input type='number' name='low' min='0' max='5000' step='1' required value='";
  s += String(lowFilamentThreshold, 0) + "'>";
  s += "<button class='ok'>Warnschwelle speichern</button></form></div>";
  s += "<div class='card'><h2>Benachrichtigungen</h2>";
  s += "<p>Alle Meldungen fuer LCD und Browser getrennt steuern.</p>";
  s += "<a class='link' href='/notifications'>Meldungen einstellen</a></div>";
  s += "<div class='card'><h2>Datensicherung</h2>";
  s += "<p>Filamentprofile, Archiv, Preise, Anzeige- und Meldungseinstellungen sichern.</p>";
  s += "<a class='link' href='/backup'>Backup als JSON herunterladen</a>";
  s += "<p class='small muted'>Bei Wiederherstellung bleibt der aktuelle Nullpunkt standardmaessig erhalten.</p>";
  s += R"HTML(<input id='restoreFile' type='file' accept='.json,application/json'>
  <label><input type='checkbox' id='restoreZero' style='width:auto'>
  Auch Nullpunkt aus Backup uebernehmen (nur auf demselben Geraet)</label>
  <button type='button' class='danger' onclick='restoreBackup()'>Backup wiederherstellen</button>
  <p id='restoreInfo' class='small'></p>
  <script>
  async function restoreBackup(){
    const f=document.getElementById('restoreFile').files[0];
    if(!f){alert('Bitte zuerst Backup-Datei waehlen.');return;}
    const body=await f.text();
    try{const b=JSON.parse(body);if(b.format!=='filamentwaage-backup')throw 1;}
    catch(e){alert('Ungueltiges Filamentwaage-Backup.');return;}
    if(!confirm('Aktuelle Profile, Archiv und Einstellungen durch Backup ersetzen?'))return;
    const zero=document.getElementById('restoreZero').checked?'1':'0';
    const r=await fetch('/restore?zero='+zero,{
      method:'POST',headers:{'Content-Type':'application/json'},body:body});
    const t=await r.text();
    document.getElementById('restoreInfo').textContent=t;
    if(r.ok)location.reload();
  }
  </script>)HTML";
  s += "</div>";

  s += "<div class='card'>";
  s += "<h2>Waage</h2>";

  s += "<p>Kalibrierung: ";
  s += "<b>-365.0 FIX</b></p>";

  s += "<p>Nullpunkt: ";
  s += String(zeroOffset);
  s += "</p>";

  s += "<p>Rohwert: ";
  s += String(rawValue);
  s += "</p>";

  s += "<p>Stabil: ";
  s += stable ? "Ja" : "Nein";
  s += "</p>";

  s += "<form method='post' action='/tare'>";
  s += "<button>";
  s += "Leere Waage tarieren";
  s += "</button>";
  s += "</form>";

  s += "</div>";
  s += htmlFoot();

  server.send(200, "text/html", s);
}

